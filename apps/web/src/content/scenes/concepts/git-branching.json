{
  "$schema": "/scene-schema.json",
  "id": "git-branching",
  "title": "Git Branching",
  "type": "concept",
  "layout": "text-left-canvas-right",
  "description": "Visualize how Git branches, merges, rebases, and resets work — from your first commit to cherry-picking and reverting.",
  "category": "Git",
  "canvas": [
    {
      "id": "commit-graph",
      "type": "graph",
      "layoutHint": "dagre-TB",
      "label": "Commit Graph",
      "initialState": {
        "nodes": [
          {
            "id": "c1",
            "label": "C1"
          }
        ],
        "edges": []
      }
    }
  ],
  "activeText": {
    "initialValue": "git commit → C1 (Initial commit)"
  },
  "controls": [
    {
      "id": "btn-commit",
      "type": "button",
      "label": "Commit",
      "config": {
        "variant": "primary",
        "defaultValue": null,
        "goToStep": 0
      }
    },
    {
      "id": "btn-branch",
      "type": "button",
      "label": "Create Branch",
      "config": {
        "variant": "primary",
        "defaultValue": null,
        "goToStep": 2
      }
    },
    {
      "id": "btn-merge",
      "type": "button",
      "label": "Merge",
      "config": {
        "variant": "primary",
        "defaultValue": null,
        "goToStep": 5
      }
    },
    {
      "id": "btn-rebase",
      "type": "button",
      "label": "Rebase",
      "config": {
        "variant": "secondary",
        "defaultValue": null,
        "goToStep": 8
      }
    }
  ],
  "steps": [
    {
      "index": 1,
      "explanation": {
        "heading": "Step 1",
        "body": "State updated."
      },
      "activeText": "git commit → C2 — HEAD → main → C2",
      "canvas": {
        "commit-graph": {
          "newNodes": [
            { "id": "c2", "label": "C2" }
          ],
          "newEdges": [
            { "id": "e-c1-c2", "from": "c1", "to": "c2" }
          ],
          "nodeStates": {
            "c2": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 2,
      "explanation": {
        "heading": "Branches are Just Pointers",
        "body": "A branch is nothing more than a **lightweight pointer** to a commit. Creating a branch is instant — it just creates a new file with a commit hash in it.\n\n`main`, `feature`, `hotfix` are all just labels. When you commit on a branch, the pointer advances.",
        "callout": "HEAD is a special pointer — it tells Git which branch (and therefore which commit) you're currently on."
      },
      "activeText": "git checkout -b feature — new pointer at C2",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c2", "label": "C2\nmain" }
          ],
          "newNodes": [
            { "id": "feat-ptr", "label": "feature" }
          ],
          "newEdges": [
            { "id": "e-feat-ptr-c2", "from": "feat-ptr", "to": "c2" }
          ],
          "nodeStates": {
            "feat-ptr": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 3,
      "explanation": {
        "heading": "Step 3",
        "body": "State updated."
      },
      "activeText": "git commit on feature → C3 — branches diverge",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c2", "label": "C2" },
            { "id": "feat-ptr", "label": "" }
          ],
          "newNodes": [
            { "id": "c3", "label": "C3" }
          ],
          "newEdges": [
            { "id": "e-c2-c3", "from": "c2", "to": "c3" }
          ],
          "nodeStates": {
            "c3": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 4,
      "explanation": {
        "heading": "Step 4",
        "body": "State updated."
      },
      "activeText": "git commit on main → C4 — divergence grows",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c3", "label": "C3\n(feature)" }
          ],
          "newNodes": [
            { "id": "c4", "label": "C4\n(main)" }
          ],
          "newEdges": [
            { "id": "e-c2-c4", "from": "c2", "to": "c4" }
          ],
          "nodeStates": {
            "c4": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 5,
      "explanation": {
        "heading": "Merge — Joining Histories",
        "body": "A **3-way merge** happens when the branches have diverged: Git finds the common ancestor commit and combines both sets of changes into a new **merge commit**.\n\nThe merge commit has two parents — both branch tips."
      },
      "activeText": "git merge feature — C5 merge commit joins both histories",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c3", "label": "C3" },
            { "id": "c4", "label": "C4" }
          ],
          "newNodes": [
            { "id": "c5", "label": "C5\nmerge" }
          ],
          "newEdges": [
            { "id": "e-c4-c5", "from": "c4", "to": "c5" },
            { "id": "e-c3-c5", "from": "c3", "to": "c5" }
          ],
          "nodeStates": {
            "c5": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 6,
      "explanation": {
        "heading": "Fast-Forward Merge",
        "body": "If one branch is directly ahead of the other (no divergence), Git can **fast-forward** — just move the pointer forward. No merge commit needed.\n\nThis is the cleanest case: linear history, no extra nodes."
      },
      "activeText": "Fast-forward merge: no divergence — HEAD just moves forward",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c2", "label": "C2\nmain→" },
            { "id": "c3", "label": "C3\nfeature" },
            { "id": "c4", "label": "" },
            { "id": "c5", "label": "" },
            { "id": "feat-ptr", "label": "" }
          ],
          "updateEdges": [
            { "id": "e-c2-c4", "highlight": "default" },
            { "id": "e-c4-c5", "highlight": "default" },
            { "id": "e-c3-c5", "highlight": "default" }
          ],
          "nodeStates": {
            "c3": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 7,
      "explanation": {
        "heading": "Step 7",
        "body": "State updated."
      },
      "activeText": "Merge conflict: both branches modified the same file",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c2", "label": "C2" },
            { "id": "c3", "label": "C3\n⚠ conflict" },
            { "id": "c4", "label": "C4\n⚠ conflict" },
            { "id": "c5", "label": "" }
          ],
          "nodeStates": {
            "c3": { "highlight": "active" },
            "c4": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 8,
      "explanation": {
        "heading": "Rebase — Rewrite History",
        "body": "Instead of creating a merge commit, `git rebase` **replays** your branch's commits on top of the target branch, one by one.\n\nResult: a clean linear history. But note — rebased commits get **new SHA hashes**. Never rebase shared/public branches.",
        "callout": "Golden rule: never rebase a branch that others are working on — you rewrite the commits they've based their work on."
      },
      "activeText": "git rebase main: commits \"replayed\" onto latest main",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c3", "label": "" },
            { "id": "c4", "label": "C4\n(main)" },
            { "id": "c5", "label": "" }
          ],
          "updateEdges": [
            { "id": "e-c3-c5", "highlight": "default" },
            { "id": "e-c4-c5", "highlight": "default" },
            { "id": "e-c2-c3", "highlight": "default" }
          ],
          "newNodes": [
            { "id": "c3r", "label": "C3'\n(rebased)" }
          ],
          "newEdges": [
            { "id": "e-c4-c3r", "from": "c4", "to": "c3r" }
          ],
          "nodeStates": {
            "c3r": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 9,
      "explanation": {
        "heading": "Step 9",
        "body": "State updated."
      },
      "activeText": "git cherry-pick C3' — copy just one commit to main",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c3r", "label": "C3'" },
            { "id": "c4", "label": "C4" }
          ],
          "newNodes": [
            { "id": "c3cp", "label": "C3''\n(cherry)" }
          ],
          "newEdges": [
            { "id": "e-c4-c3cp", "from": "c4", "to": "c3cp" }
          ],
          "nodeStates": {
            "c3cp": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 10,
      "explanation": {
        "heading": "Cherry-Pick and Reset vs Revert",
        "body": "- **Cherry-pick**: copy a specific commit from one branch to another. Useful for backporting fixes.\n- **Reset --hard**: destructively move HEAD back — commits are lost (unless you have the SHA).\n- **Revert**: safe alternative — creates a *new* commit that undoes the changes. History is preserved. Use on shared branches."
      },
      "activeText": "git reset --hard C4 — HEAD moves back, C3'' disappears",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c4", "label": "C4\n← HEAD" },
            { "id": "c3cp", "label": "" }
          ],
          "nodeStates": {
            "c4": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 11,
      "explanation": {
        "heading": "Step 11",
        "body": "State updated."
      },
      "activeText": "git revert C4 — new commit C5 that undoes C4's changes",
      "canvas": {
        "commit-graph": {
          "updateNodes": [
            { "id": "c4", "label": "C4" }
          ],
          "newNodes": [
            { "id": "c5rev", "label": "C5\nrevert" }
          ],
          "newEdges": [
            { "id": "e-c4-c5rev", "from": "c4", "to": "c5rev" }
          ],
          "nodeStates": {
            "c5rev": { "highlight": "active" }
          }
        }
      }
    }
  ],
  "popups": [
    {
      "id": "pop-branch-cheap",
      "attachTo": "commit-graph",
      "text": "Creating a branch is O(1) — just a file!",
      "showAtStep": 2,
      "hideAtStep": 3,
      "style": "info"
    },
    {
      "id": "pop-merge-commit",
      "attachTo": "commit-graph",
      "text": "Merge commit has 2 parents",
      "showAtStep": 5,
      "hideAtStep": 6,
      "style": "info"
    },
    {
      "id": "pop-rebase-new-sha",
      "attachTo": "commit-graph",
      "text": "C3' has a new SHA — it's a copy, not a move",
      "showAtStep": 8,
      "hideAtStep": 9,
      "style": "warning"
    },
    {
      "id": "pop-reset-danger",
      "attachTo": "commit-graph",
      "text": "Commits can be recovered with git reflog",
      "showAtStep": 10,
      "hideAtStep": 11,
      "style": "warning"
    }
  ],
  "challenges": [
    {
      "id": "ch-merge-vs-rebase",
      "title": "Merge vs Rebase Trade-off",
      "description": "Your team follows a rule: all PRs must be rebased before merging. What problem does this solve vs. always using merge commits? What's the downside if someone force-pushes a rebased branch that others have checked out?",
      "type": "predict"
    },
    {
      "id": "ch-detached-head",
      "title": "Detached HEAD State",
      "description": "Run `git checkout C2` (a commit hash instead of a branch name). You're now in detached HEAD state. If you commit from here, what happens when you checkout main again? How do you save those commits?",
      "type": "scenario"
    },
    {
      "id": "ch-recover-reset",
      "title": "Recover After git reset --hard",
      "description": "You accidentally ran `git reset --hard HEAD~3` and lost 3 commits. The commits aren't on any branch. How do you recover them? Hint: `git reflog` is your friend.",
      "type": "break-it"
    }
  ]
}
