{
  "$schema": "/scene-schema.json",
  "id": "load-balancer",
  "title": "Load Balancer",
  "type": "concept",
  "layout": "text-left-canvas-right",
  "description": "See how load balancers distribute traffic across servers using Round Robin, Least Connections, and Weighted algorithms.",
  "category": "System Design",
  "canvas": [
    {
      "id": "lb-system",
      "type": "system-diagram",
      "layoutHint": "dagre-LR",
      "label": "Load Balancer System",
      "initialState": {
        "components": [
          {
            "id": "client",
            "label": "Client",
            "icon": "web",
            "status": "normal"
          },
          {
            "id": "lb",
            "label": "Load Balancer",
            "icon": "compute",
            "status": "normal"
          },
          {
            "id": "s1",
            "label": "Server 1",
            "icon": "server",
            "status": "normal"
          },
          {
            "id": "s2",
            "label": "Server 2",
            "icon": "server",
            "status": "normal"
          },
          {
            "id": "s3",
            "label": "Server 3",
            "icon": "server",
            "status": "normal"
          }
        ],
        "connections": [
          {
            "id": "conn-client-lb",
            "from": "client",
            "to": "lb",
            "active": false
          },
          {
            "id": "conn-lb-s1",
            "from": "lb",
            "to": "s1",
            "active": false
          },
          {
            "id": "conn-lb-s2",
            "from": "lb",
            "to": "s2",
            "active": false
          },
          {
            "id": "conn-lb-s3",
            "from": "lb",
            "to": "s3",
            "active": false
          }
        ]
      }
    }
  ],
  "activeText": {
    "initialValue": "Algorithm: Round Robin"
  },
  "hud": [
    {
      "id": "s1-count",
      "label": "Server 1 Reqs",
      "initialValue": 0
    },
    {
      "id": "s2-count",
      "label": "Server 2 Reqs",
      "initialValue": 0
    },
    {
      "id": "s3-count",
      "label": "Server 3 Reqs",
      "initialValue": 0
    }
  ],
  "controls": [
    {
      "id": "algorithm",
      "type": "toggle-group",
      "label": "Algorithm",
      "config": {
        "options": [
          "Round Robin",
          "Least Connections",
          "Weighted"
        ],
        "defaultValue": "Round Robin"
      }
    },
    {
      "id": "rps",
      "type": "slider",
      "label": "Requests / sec",
      "config": {
        "min": 1,
        "max": 20,
        "step": 1,
        "defaultValue": 5
      }
    },
    {
      "id": "btn-kill-s2",
      "type": "button",
      "label": "Kill Server 2",
      "config": {
        "variant": "destructive",
        "defaultValue": null,
        "goToStep": 6
      }
    },
    {
      "id": "btn-add-server",
      "type": "button",
      "label": "Add Server",
      "config": {
        "variant": "primary",
        "defaultValue": null,
        "goToStep": 7
      }
    },
    {
      "id": "btn-spike",
      "type": "button",
      "label": "Traffic Spike",
      "config": {
        "variant": "destructive",
        "defaultValue": null,
        "goToStep": 9
      }
    }
  ],
  "steps": [
    {
      "index": 1,
      "explanation": {
        "heading": "Round Robin — Simple and Fair",
        "body": "The simplest algorithm: each new request goes to the next server in a circular sequence.\n\n**Request 1 → S1, Request 2 → S2, Request 3 → S3, Request 4 → S1…**\n\nNo state needed. Works great when all requests are similar in cost.",
        "callout": "Round Robin ignores server load — it doesn't know if S1 is stuck processing a slow request."
      },
      "activeText": "Round Robin — Request 1 → Server 1",
      "hud": {
        "s1-count": 1
      },
      "canvas": {
        "lb-system": {
          "componentStates": {
            "client": { "status": "active" },
            "lb": { "status": "active" },
            "s1": { "status": "active" },
            "s2": { "status": "normal" },
            "s3": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-lb": { "active": true },
            "conn-lb-s1": { "active": true },
            "conn-lb-s2": { "active": false },
            "conn-lb-s3": { "active": false }
          }
        }
      }
    },
    {
      "index": 2,
      "explanation": {
        "heading": "Step 2",
        "body": "State updated."
      },
      "activeText": "Round Robin — Request 2 → Server 2",
      "hud": {
        "s2-count": 1
      },
      "canvas": {
        "lb-system": {
          "componentStates": {
            "client": { "status": "active" },
            "lb": { "status": "active" },
            "s1": { "status": "normal" },
            "s2": { "status": "active" },
            "s3": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-lb": { "active": true },
            "conn-lb-s1": { "active": false },
            "conn-lb-s2": { "active": true },
            "conn-lb-s3": { "active": false }
          }
        }
      }
    },
    {
      "index": 3,
      "explanation": {
        "heading": "Step 3",
        "body": "State updated."
      },
      "activeText": "Round Robin — Request 3 → Server 3",
      "hud": {
        "s3-count": 1
      },
      "canvas": {
        "lb-system": {
          "componentStates": {
            "client": { "status": "active" },
            "lb": { "status": "active" },
            "s1": { "status": "normal" },
            "s2": { "status": "normal" },
            "s3": { "status": "active" }
          },
          "connectionStates": {
            "conn-client-lb": { "active": true },
            "conn-lb-s1": { "active": false },
            "conn-lb-s2": { "active": false },
            "conn-lb-s3": { "active": true }
          }
        }
      }
    },
    {
      "index": 4,
      "explanation": {
        "heading": "Step 4",
        "body": "State updated."
      },
      "activeText": "Round Robin cycles — Request 4 → Server 1 again",
      "hud": {
        "s1-count": 2
      },
      "canvas": {
        "lb-system": {
          "componentStates": {
            "client": { "status": "active" },
            "lb": { "status": "active" },
            "s1": { "status": "active" },
            "s2": { "status": "normal" },
            "s3": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-lb": { "active": true },
            "conn-lb-s1": { "active": true },
            "conn-lb-s2": { "active": false },
            "conn-lb-s3": { "active": false }
          }
        }
      }
    },
    {
      "index": 5,
      "explanation": {
        "heading": "Least Connections — Smarter Routing",
        "body": "Track how many active connections each server has. Route the next request to the server with the **fewest active connections**.\n\nBetter for scenarios where request processing times vary significantly (e.g., fast DB reads vs slow file uploads)."
      },
      "activeText": "Least Connections — Server 2 has fewest → route there",
      "hud": {
        "s2-count": 2
      },
      "canvas": {
        "lb-system": {
          "componentStates": {
            "client": { "status": "active" },
            "lb": { "status": "active" },
            "s1": { "status": "normal" },
            "s2": { "status": "active" },
            "s3": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-lb": { "active": true },
            "conn-lb-s1": { "active": false },
            "conn-lb-s2": { "active": true },
            "conn-lb-s3": { "active": false }
          }
        }
      }
    },
    {
      "index": 6,
      "explanation": {
        "heading": "Fault Tolerance — Handling Server Failure",
        "body": "Load balancers run **health checks** (ping each server every few seconds). If a server fails, the LB stops routing to it.\n\nRequests are redistributed to the remaining healthy servers. Users experience a brief slowdown but no outage.",
        "callout": "This is why production systems run at least 3 servers — N-1 redundancy means one server can always fail safely."
      },
      "activeText": "Server 2 killed — requests re-route to Server 1 and 3",
      "hud": {
        "s1-count": 4,
        "s2-count": 0,
        "s3-count": 3
      },
      "canvas": {
        "lb-system": {
          "componentStates": {
            "client": { "status": "active" },
            "lb": { "status": "active" },
            "s1": { "status": "active" },
            "s2": { "status": "dead" },
            "s3": { "status": "active" }
          },
          "connectionStates": {
            "conn-client-lb": { "active": true },
            "conn-lb-s1": { "active": true },
            "conn-lb-s2": { "active": false },
            "conn-lb-s3": { "active": true }
          }
        }
      }
    },
    {
      "index": 7,
      "explanation": {
        "heading": "Step 7",
        "body": "State updated."
      },
      "activeText": "Server 2 back online — load redistributes",
      "hud": {
        "s2-count": 2
      },
      "canvas": {
        "lb-system": {
          "componentStates": {
            "client": { "status": "normal" },
            "lb": { "status": "active" },
            "s1": { "status": "normal" },
            "s2": { "status": "active" },
            "s3": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-lb": { "active": false },
            "conn-lb-s1": { "active": false },
            "conn-lb-s2": { "active": true },
            "conn-lb-s3": { "active": false }
          }
        }
      }
    },
    {
      "index": 8,
      "explanation": {
        "heading": "Weighted Round Robin",
        "body": "Assign a **weight** to each server proportional to its capacity. A server with weight 2 gets twice as many requests as one with weight 1.\n\nUse this when servers have different hardware specs — no reason to treat a 32-core machine the same as an 8-core one."
      },
      "activeText": "Weighted: Server 3 is 2× powerful → gets 2× requests",
      "hud": {
        "s3-count": 6
      },
      "canvas": {
        "lb-system": {
          "componentStates": {
            "client": { "status": "active" },
            "lb": { "status": "active" },
            "s1": { "status": "normal" },
            "s2": { "status": "normal" },
            "s3": { "status": "active" }
          },
          "connectionStates": {
            "conn-client-lb": { "active": true },
            "conn-lb-s1": { "active": false },
            "conn-lb-s2": { "active": false },
            "conn-lb-s3": { "active": true }
          }
        }
      }
    },
    {
      "index": 9,
      "explanation": {
        "heading": "Traffic Spikes — Scaling Out",
        "body": "When all servers are overloaded, the load balancer can't help by itself. Solutions:\n- **Horizontal scaling**: spin up more servers (auto-scaling groups in AWS, GKE, etc.)\n- **Rate limiting**: reject or queue excess requests\n- **Circuit breaker**: return a fast error to clients rather than queuing forever"
      },
      "activeText": "Traffic spike! All servers overloaded",
      "hud": {
        "s1-count": 99,
        "s2-count": 99,
        "s3-count": 99
      },
      "canvas": {
        "lb-system": {
          "componentStates": {
            "client": { "status": "active" },
            "lb": { "status": "active" },
            "s1": { "status": "overloaded" },
            "s2": { "status": "overloaded" },
            "s3": { "status": "overloaded" }
          },
          "connectionStates": {
            "conn-client-lb": { "active": true },
            "conn-lb-s1": { "active": true },
            "conn-lb-s2": { "active": true },
            "conn-lb-s3": { "active": true }
          }
        }
      }
    }
  ],
  "popups": [
    {
      "id": "pop-rr-cycle",
      "attachTo": "lb-system",
      "text": "Cycles: S1 → S2 → S3 → S1…",
      "showAtStep": 4,
      "hideAtStep": 5,
      "style": "info"
    },
    {
      "id": "pop-failover",
      "attachTo": "lb-system",
      "text": "Health check failed — removing S2",
      "showAtStep": 6,
      "hideAtStep": 7,
      "style": "warning"
    },
    {
      "id": "pop-spike",
      "attachTo": "lb-system",
      "text": "Consider horizontal auto-scaling!",
      "showAtStep": 9,
      "hideAtStep": 10,
      "style": "insight"
    }
  ],
  "challenges": [
    {
      "id": "ch-sticky-session",
      "title": "Sticky Sessions Problem",
      "description": "Imagine a user logs in and their session is stored in Server 1's memory. The next request goes to Server 2 (round robin) — they're logged out! How would you solve this without changing the load balancing algorithm?",
      "type": "scenario"
    },
    {
      "id": "ch-two-servers-fail",
      "title": "Two Servers Fail Simultaneously",
      "description": "Kill Server 1 and Server 3 using the controls, leaving only Server 2. What happens to your request rate? What's the minimum number of servers you'd run in production for a service that needs 99.9% uptime?",
      "type": "break-it"
    },
    {
      "id": "ch-optimal-weights",
      "title": "Optimize Weights",
      "description": "You have 3 servers: S1 (4-core), S2 (8-core), S3 (16-core). What weights would you assign to make each server process the same percentage of its capacity? Show your calculation.",
      "type": "optimize"
    }
  ]
}
