{
  "$schema": "/scene-schema.json",
  "id": "hash-tables",
  "title": "Hash Tables",
  "type": "concept",
  "layout": "text-left-canvas-right",
  "description": "Explore how hash tables work — from hashing keys to handling collisions with chaining and open addressing.",
  "category": "Data Structures",
  "canvas": [
    {
      "id": "bucket-array",
      "type": "linear",
      "variant": "array",
      "layoutHint": "linear-H",
      "label": "Buckets",
      "initialState": {
        "items": [
          {
            "id": "b0",
            "value": "—"
          },
          {
            "id": "b1",
            "value": "—"
          },
          {
            "id": "b2",
            "value": "—"
          },
          {
            "id": "b3",
            "value": "—"
          }
        ]
      }
    },
    {
      "id": "hash-map",
      "type": "map",
      "layoutHint": "hashmap-buckets",
      "label": "Hash Table",
      "initialState": {
        "entries": []
      }
    }
  ],
  "activeText": {
    "initialValue": "Ready — insert a key to begin"
  },
  "hud": [
    {
      "id": "load-factor",
      "label": "Load Factor",
      "initialValue": 0
    },
    {
      "id": "collisions",
      "label": "Collisions",
      "initialValue": 0
    }
  ],
  "controls": [
    {
      "id": "collision-mode",
      "type": "toggle-group",
      "label": "Collision Strategy",
      "config": {
        "options": [
          "Chaining",
          "Open Addressing"
        ],
        "defaultValue": "Chaining"
      }
    },
    {
      "id": "table-size",
      "type": "slider",
      "label": "Table Size",
      "config": {
        "min": 4,
        "max": 16,
        "step": 4,
        "defaultValue": 4
      }
    },
    {
      "id": "btn-insert",
      "type": "button",
      "label": "Insert",
      "config": {
        "variant": "primary",
        "defaultValue": null
      }
    },
    {
      "id": "btn-reset",
      "type": "button",
      "label": "Reset",
      "config": {
        "variant": "secondary",
        "defaultValue": null
      }
    }
  ],
  "steps": [
    {
      "index": 1,
      "explanation": {
        "heading": "Inserting Keys — Hashing",
        "body": "When you insert `\"alice\"`, the hash function computes `hash(\"alice\") % tableSize = 1`.\n\nThe key-value pair lands in **bucket 1**. Lookup works the same way — hash the key, check that bucket.",
        "callout": "Notice bucket 1 light up. The hash function is deterministic — same key always hashes to the same bucket."
      },
      "activeText": "hash(\"alice\") → 5 % 4 = 1",
      "hud": {
        "load-factor": 0.25
      },
      "canvas": {
        "bucket-array": {
          "items": [
            {
              "id": "b0",
              "value": "—"
            },
            {
              "id": "b1",
              "value": "alice",
              "highlight": "insert"
            },
            {
              "id": "b2",
              "value": "—"
            },
            {
              "id": "b3",
              "value": "—"
            }
          ]
        },
        "hash-map": {
          "entries": [
            {
              "id": "entry-alice",
              "key": "alice",
              "value": "28",
              "highlight": "insert"
            }
          ]
        }
      }
    },
    {
      "index": 2,
      "explanation": {
        "heading": "Step 2",
        "body": "State updated."
      },
      "activeText": "hash(\"bob\") → 3 % 4 = 3",
      "hud": {
        "load-factor": 0.5
      },
      "canvas": {
        "bucket-array": {
          "items": [
            {
              "id": "b0",
              "value": "—"
            },
            {
              "id": "b1",
              "value": "alice"
            },
            {
              "id": "b2",
              "value": "—"
            },
            {
              "id": "b3",
              "value": "bob",
              "highlight": "insert"
            }
          ]
        },
        "hash-map": {
          "entries": [
            {
              "id": "entry-alice",
              "key": "alice",
              "value": "28"
            },
            {
              "id": "entry-bob",
              "key": "bob",
              "value": "34",
              "highlight": "insert"
            }
          ]
        }
      }
    },
    {
      "index": 3,
      "explanation": {
        "heading": "Collision — Two Keys, One Bucket",
        "body": "`\"carol\"` also hashes to bucket 1 — the same slot as `\"alice\"`. This is a **collision**.\n\n**Chaining** resolves it by storing a linked list of entries in the bucket. Both `alice` and `carol` coexist as a chain.",
        "callout": "Real hash tables aim for load factor < 0.75 to keep chains short."
      },
      "activeText": "hash(\"carol\") → 5 % 4 = 1  ⚠ COLLISION!",
      "hud": {
        "collisions": 1,
        "load-factor": 0.75
      },
      "canvas": {
        "bucket-array": {
          "items": [
            {
              "id": "b0",
              "value": "—"
            },
            {
              "id": "b1",
              "value": "alice→carol",
              "highlight": "active"
            },
            {
              "id": "b2",
              "value": "—"
            },
            {
              "id": "b3",
              "value": "bob"
            }
          ]
        },
        "hash-map": {
          "entries": [
            {
              "id": "entry-alice",
              "key": "alice",
              "value": "28"
            },
            {
              "id": "entry-bob",
              "key": "bob",
              "value": "34"
            },
            {
              "id": "entry-carol",
              "key": "carol",
              "value": "22",
              "highlight": "insert"
            }
          ]
        }
      }
    },
    {
      "index": 4,
      "explanation": {
        "heading": "Lookup: HIT vs MISS",
        "body": "For a **HIT**: hash the key → go to the bucket → scan the chain until a matching key is found.\n\nFor a **MISS**: hash the key → go to the bucket → reach the end of the chain without a match. Returns `null`."
      },
      "activeText": "lookup(\"alice\") → bucket 1 → scan chain → HIT ✓",
      "canvas": {
        "bucket-array": {
          "items": [
            {
              "id": "b0",
              "value": "—"
            },
            {
              "id": "b1",
              "value": "alice→carol",
              "highlight": "hit"
            },
            {
              "id": "b2",
              "value": "—"
            },
            {
              "id": "b3",
              "value": "bob"
            }
          ]
        },
        "hash-map": {
          "entries": [
            {
              "id": "entry-alice",
              "key": "alice",
              "value": "28",
              "highlight": "hit"
            },
            {
              "id": "entry-bob",
              "key": "bob",
              "value": "34"
            },
            {
              "id": "entry-carol",
              "key": "carol",
              "value": "22"
            }
          ]
        }
      }
    },
    {
      "index": 5,
      "explanation": {
        "heading": "Step 5",
        "body": "State updated."
      },
      "activeText": "lookup(\"dave\") → bucket 0 → empty → MISS ✗",
      "canvas": {
        "bucket-array": {
          "items": [
            {
              "id": "b0",
              "value": "—",
              "highlight": "error"
            },
            {
              "id": "b1",
              "value": "alice→carol"
            },
            {
              "id": "b2",
              "value": "—"
            },
            {
              "id": "b3",
              "value": "bob"
            }
          ]
        },
        "hash-map": {
          "entries": [
            {
              "id": "entry-alice",
              "key": "alice",
              "value": "28"
            },
            {
              "id": "entry-bob",
              "key": "bob",
              "value": "34"
            },
            {
              "id": "entry-carol",
              "key": "carol",
              "value": "22"
            },
            {
              "id": "entry-dave",
              "key": "dave",
              "value": "???"
            }
          ]
        }
      }
    },
    {
      "index": 6,
      "explanation": {
        "heading": "Rehashing — Keeping it Fast",
        "body": "When load factor (entries ÷ buckets) exceeds **0.75**, the table is **rehashed**: a new array of double the size is allocated and all existing keys are reinserted.\n\nThis keeps average chain length ≤ 1 and maintains O(1) lookup.",
        "callout": "Rehashing is O(n) but happens rarely — amortized cost per insertion remains O(1)."
      },
      "activeText": "Load factor ≥ 0.75 → Rehashing! Doubling table size…",
      "hud": {
        "load-factor": 0.75
      },
      "canvas": {
        "bucket-array": {
          "items": [
            {
              "id": "b0",
              "value": "—",
              "highlight": "active"
            },
            {
              "id": "b1",
              "value": "—",
              "highlight": "active"
            },
            {
              "id": "b2",
              "value": "—",
              "highlight": "active"
            },
            {
              "id": "b3",
              "value": "—",
              "highlight": "active"
            }
          ]
        }
      }
    },
    {
      "index": 7,
      "explanation": {
        "heading": "Step 7",
        "body": "State updated."
      },
      "activeText": "Rehashed! New size: 8 — all keys redistributed",
      "hud": {
        "load-factor": 0.38,
        "collisions": 0
      },
      "canvas": {
        "bucket-array": {
          "items": [
            {
              "id": "b0",
              "value": "—"
            },
            {
              "id": "b1",
              "value": "alice"
            },
            {
              "id": "b2",
              "value": "—"
            },
            {
              "id": "b3",
              "value": "bob"
            },
            {
              "id": "b4",
              "value": "—"
            },
            {
              "id": "b5",
              "value": "carol",
              "highlight": "insert"
            },
            {
              "id": "b6",
              "value": "—"
            },
            {
              "id": "b7",
              "value": "—"
            }
          ]
        },
        "hash-map": {
          "entries": [
            {
              "id": "entry-alice",
              "key": "alice",
              "value": "28"
            },
            {
              "id": "entry-bob",
              "key": "bob",
              "value": "34"
            },
            {
              "id": "entry-carol",
              "key": "carol",
              "value": "22",
              "highlight": "insert"
            }
          ]
        }
      }
    },
    {
      "index": 8,
      "explanation": {
        "heading": "Open Addressing — No Chains",
        "body": "In **open addressing**, there's no chaining. Instead, when a collision occurs, the algorithm **probes** for the next empty slot: `slot = (hash + i) % size` for i = 0, 1, 2…\n\nAll entries live directly in the array — better cache locality, but max load factor must stay lower."
      },
      "activeText": "Open Addressing: insert \"dave\" → probe slot 0 → 1 → 2 (empty!)",
      "hud": {
        "load-factor": 0.5
      },
      "canvas": {
        "bucket-array": {
          "items": [
            {
              "id": "b0",
              "value": "—",
              "highlight": "error"
            },
            {
              "id": "b1",
              "value": "alice",
              "highlight": "error"
            },
            {
              "id": "b2",
              "value": "dave",
              "highlight": "insert"
            },
            {
              "id": "b3",
              "value": "bob"
            },
            {
              "id": "b4",
              "value": "—"
            },
            {
              "id": "b5",
              "value": "carol"
            },
            {
              "id": "b6",
              "value": "—"
            },
            {
              "id": "b7",
              "value": "—"
            }
          ]
        },
        "hash-map": {
          "entries": [
            {
              "id": "entry-alice",
              "key": "alice",
              "value": "28"
            },
            {
              "id": "entry-bob",
              "key": "bob",
              "value": "34"
            },
            {
              "id": "entry-carol",
              "key": "carol",
              "value": "22"
            },
            {
              "id": "entry-dave",
              "key": "dave",
              "value": "19",
              "highlight": "insert"
            }
          ]
        }
      }
    },
    {
      "index": 9,
      "explanation": {
        "heading": "Deletion with Tombstones",
        "body": "Deleting in open addressing is tricky — you can't just empty the slot, or future probes will stop early (false MISS).\n\nThe solution: mark deleted slots as **tombstones** (⌫). Probes skip tombstones but new insertions can reuse them."
      },
      "activeText": "delete(\"alice\") → find slot 1 → mark as tombstone",
      "hud": {
        "load-factor": 0.38
      },
      "canvas": {
        "bucket-array": {
          "items": [
            {
              "id": "b0",
              "value": "—"
            },
            {
              "id": "b1",
              "value": "⌫",
              "highlight": "error"
            },
            {
              "id": "b2",
              "value": "dave"
            },
            {
              "id": "b3",
              "value": "bob"
            },
            {
              "id": "b4",
              "value": "—"
            },
            {
              "id": "b5",
              "value": "carol"
            },
            {
              "id": "b6",
              "value": "—"
            },
            {
              "id": "b7",
              "value": "—"
            }
          ]
        },
        "hash-map": {
          "entries": [
            {
              "id": "entry-bob",
              "key": "bob",
              "value": "34"
            },
            {
              "id": "entry-carol",
              "key": "carol",
              "value": "22"
            },
            {
              "id": "entry-dave",
              "key": "dave",
              "value": "19"
            },
            {
              "id": "entry-alice",
              "key": "alice",
              "value": "deleted",
              "highlight": "remove"
            }
          ]
        }
      }
    }
  ],
  "popups": [
    {
      "id": "pop-hash-alice",
      "attachTo": "bucket-array",
      "text": "hash(\"alice\") = 1",
      "showAtStep": 1,
      "hideAtStep": 2,
      "style": "info"
    },
    {
      "id": "pop-collision",
      "attachTo": "bucket-array",
      "text": "Collision! Chaining: alice → carol",
      "showAtStep": 3,
      "hideAtStep": 4,
      "style": "warning"
    },
    {
      "id": "pop-hit",
      "attachTo": "hash-map",
      "text": "HIT — found alice in chain",
      "showAtStep": 4,
      "hideAtStep": 5,
      "style": "success"
    },
    {
      "id": "pop-miss",
      "attachTo": "bucket-array",
      "text": "MISS — bucket 0 is empty",
      "showAtStep": 5,
      "hideAtStep": 6,
      "style": "warning"
    },
    {
      "id": "pop-rehash",
      "attachTo": "bucket-array",
      "text": "Load factor ≥ 0.75 — rehashing now",
      "showAtStep": 6,
      "hideAtStep": 7,
      "style": "warning"
    }
  ],
  "challenges": [
    {
      "id": "ch-predict-collision",
      "title": "Predict a Collision",
      "description": "With a table of size 4, which other key would collide with \"alice\" (bucket 1)? Try inserting \"eve\" (3 chars → 3%4=3) and \"frank\" (5 chars → 5%4=1) — which one collides?",
      "type": "predict"
    },
    {
      "id": "ch-break-load",
      "title": "Break it: overflow the table",
      "description": "Try to get the load factor above 1.0 using chaining mode with table size 4. How many entries do you need? What happens to lookup performance?",
      "type": "break-it"
    },
    {
      "id": "ch-open-address-full",
      "title": "Open Addressing at 100% Load",
      "description": "Switch to Open Addressing and fill the table completely (load = 1.0). Now try to insert one more key. What happens? Why is open addressing usually capped at 70%?",
      "type": "optimize"
    }
  ]
}
