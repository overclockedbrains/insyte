{
  "$schema": "/scene-schema.json",
  "id": "dns-resolution",
  "title": "DNS Resolution",
  "type": "concept",
  "layout": "text-left-canvas-right",
  "description": "Watch how a domain name like insyte.amanarya.com gets resolved to an IP address — from browser cache to root servers and back.",
  "category": "Networking",
  "canvas": [
    {
      "id": "dns-system",
      "type": "system-diagram",
      "layoutHint": "dagre-LR",
      "label": "DNS Resolution Chain",
      "initialState": {
        "components": [
          {
            "id": "browser",
            "label": "Browser",
            "icon": "web",
            "status": "active"
          },
          {
            "id": "resolver",
            "label": "Recursive Resolver",
            "icon": "compute",
            "status": "normal"
          },
          {
            "id": "root-ns",
            "label": "Root NS",
            "icon": "database",
            "status": "normal"
          },
          {
            "id": "tld-ns",
            "label": ".com TLD NS",
            "icon": "database",
            "status": "normal"
          },
          {
            "id": "auth-ns",
            "label": "Authoritative NS",
            "icon": "database",
            "status": "normal"
          }
        ],
        "connections": [
          {
            "id": "conn-browser-resolver",
            "from": "browser",
            "to": "resolver",
            "active": false
          },
          {
            "id": "conn-resolver-root-ns",
            "from": "resolver",
            "to": "root-ns",
            "active": false
          },
          {
            "id": "conn-resolver-tld-ns",
            "from": "resolver",
            "to": "tld-ns",
            "active": false
          },
          {
            "id": "conn-resolver-auth-ns",
            "from": "resolver",
            "to": "auth-ns",
            "active": false
          }
        ]
      }
    }
  ],
  "activeText": {
    "initialValue": "Browser: lookup insyte.amanarya.com → local cache MISS"
  },
  "hud": [
    {
      "id": "latency",
      "label": "Total Latency",
      "initialValue": 0
    }
  ],
  "controls": [
    {
      "id": "cache-toggle",
      "type": "toggle",
      "label": "Browser Cache",
      "config": {
        "defaultValue": true
      }
    },
    {
      "id": "latency-sim",
      "type": "slider",
      "label": "Simulated Latency per Hop (ms)",
      "config": {
        "min": 10,
        "max": 200,
        "step": 10,
        "defaultValue": 30
      }
    },
    {
      "id": "btn-query",
      "type": "button",
      "label": "Query Again",
      "config": {
        "variant": "primary",
        "defaultValue": null
      }
    },
    {
      "id": "btn-clear-cache",
      "type": "button",
      "label": "Clear Cache",
      "config": {
        "variant": "secondary",
        "defaultValue": null
      }
    }
  ],
  "steps": [
    {
      "index": 1,
      "explanation": {
        "heading": "The Recursive Resolver",
        "body": "Your ISP or a public DNS service (like `1.1.1.1` or `8.8.8.8`) runs a **recursive resolver** — it does the legwork of querying multiple name servers on your behalf and returns the final answer.\n\nWithout caching, a full lookup involves **3 round-trips** to 3 different servers.",
        "callout": "Cloudflare's 1.1.1.1 and Google's 8.8.8.8 are the most popular public recursive resolvers."
      },
      "activeText": "Query sent to Recursive Resolver — resolver cache MISS",
      "hud": {
        "latency": 5
      },
      "canvas": {
        "dns-system": {
          "componentStates": {
            "browser": { "status": "active" },
            "resolver": { "status": "active" },
            "root-ns": { "status": "normal" },
            "tld-ns": { "status": "normal" },
            "auth-ns": { "status": "normal" }
          },
          "connectionStates": {
            "conn-browser-resolver": { "active": true },
            "conn-resolver-root-ns": { "active": false },
            "conn-resolver-tld-ns": { "active": false },
            "conn-resolver-auth-ns": { "active": false }
          }
        }
      }
    },
    {
      "index": 2,
      "explanation": {
        "heading": "The DNS Hierarchy",
        "body": "DNS is organized as a tree:\n- **Root (`.`)**: 13 root server clusters worldwide, knows where all TLD servers are\n- **TLD (`.dev`, `.com`, `.io`)**: knows which authoritative NS handles each domain\n- **Authoritative NS**: the definitive answer — stores actual DNS records like A, CNAME, MX"
      },
      "activeText": "Resolver asks Root NS: Who handles .com?",
      "hud": {
        "latency": 35
      },
      "canvas": {
        "dns-system": {
          "componentStates": {
            "browser": { "status": "normal" },
            "resolver": { "status": "active" },
            "root-ns": { "status": "active" },
            "tld-ns": { "status": "normal" },
            "auth-ns": { "status": "normal" }
          },
          "connectionStates": {
            "conn-browser-resolver": { "active": false },
            "conn-resolver-root-ns": { "active": true },
            "conn-resolver-tld-ns": { "active": false },
            "conn-resolver-auth-ns": { "active": false }
          }
        }
      }
    },
    {
      "index": 3,
      "explanation": {
        "heading": "Step 3",
        "body": "State updated."
      },
      "activeText": "Root NS replies: .com TLD NS is at a Verisign .com name server",
      "hud": {
        "latency": 70
      },
      "canvas": {
        "dns-system": {
          "componentStates": {
            "browser": { "status": "normal" },
            "resolver": { "status": "active" },
            "root-ns": { "status": "normal" },
            "tld-ns": { "status": "active" },
            "auth-ns": { "status": "normal" }
          },
          "connectionStates": {
            "conn-browser-resolver": { "active": false },
            "conn-resolver-root-ns": { "active": false },
            "conn-resolver-tld-ns": { "active": true },
            "conn-resolver-auth-ns": { "active": false }
          }
        }
      }
    },
    {
      "index": 4,
      "explanation": {
        "heading": "Step 4",
        "body": "State updated."
      },
      "activeText": "TLD NS replies: amanarya.com NS is at ns1.vercel-dns.com",
      "hud": {
        "latency": 110
      },
      "canvas": {
        "dns-system": {
          "componentStates": {
            "browser": { "status": "normal" },
            "resolver": { "status": "active" },
            "root-ns": { "status": "normal" },
            "tld-ns": { "status": "normal" },
            "auth-ns": { "status": "active" }
          },
          "connectionStates": {
            "conn-browser-resolver": { "active": false },
            "conn-resolver-root-ns": { "active": false },
            "conn-resolver-tld-ns": { "active": false },
            "conn-resolver-auth-ns": { "active": true }
          }
        }
      }
    },
    {
      "index": 5,
      "explanation": {
        "heading": "Step 5",
        "body": "State updated."
      },
      "activeText": "Authoritative NS returns: insyte.amanarya.com → 76.76.21.21",
      "hud": {
        "latency": 145
      },
      "canvas": {
        "dns-system": {
          "componentStates": {
            "browser": { "status": "active" },
            "resolver": { "status": "active" },
            "root-ns": { "status": "normal" },
            "tld-ns": { "status": "normal" },
            "auth-ns": { "status": "normal" }
          },
          "connectionStates": {
            "conn-browser-resolver": { "active": true },
            "conn-resolver-root-ns": { "active": false },
            "conn-resolver-tld-ns": { "active": false },
            "conn-resolver-auth-ns": { "active": false }
          }
        }
      }
    },
    {
      "index": 6,
      "explanation": {
        "heading": "Caching — The Real Performance Win",
        "body": "A cold DNS lookup can take 100–300ms. But the result is **cached** at both the resolver and browser levels.\n\nSubsequent requests to the same domain are served from cache in **< 1ms** — a 300× speedup. Most domains have a TTL (Time to Live) of 300–3600 seconds.",
        "callout": "This is why DNS changes take time to propagate — existing cached entries must expire first."
      },
      "activeText": "IP cached by browser (TTL: 300s) and resolver",
      "hud": {
        "latency": 150
      },
      "canvas": {
        "dns-system": {
          "componentStates": {
            "browser": { "status": "active" },
            "resolver": { "status": "active" },
            "root-ns": { "status": "normal" },
            "tld-ns": { "status": "normal" },
            "auth-ns": { "status": "normal" }
          },
          "connectionStates": {
            "conn-browser-resolver": { "active": false },
            "conn-resolver-root-ns": { "active": false },
            "conn-resolver-tld-ns": { "active": false },
            "conn-resolver-auth-ns": { "active": false }
          }
        }
      }
    },
    {
      "index": 7,
      "explanation": {
        "heading": "Step 7",
        "body": "State updated."
      },
      "activeText": "Second request: browser cache HIT → instant! (0ms)",
      "hud": {
        "latency": 0
      },
      "canvas": {
        "dns-system": {
          "componentStates": {
            "browser": { "status": "active" },
            "resolver": { "status": "normal" },
            "root-ns": { "status": "normal" },
            "tld-ns": { "status": "normal" },
            "auth-ns": { "status": "normal" }
          },
          "connectionStates": {
            "conn-browser-resolver": { "active": false },
            "conn-resolver-root-ns": { "active": false },
            "conn-resolver-tld-ns": { "active": false },
            "conn-resolver-auth-ns": { "active": false }
          }
        }
      }
    },
    {
      "index": 8,
      "explanation": {
        "heading": "TTL and Cache Expiry",
        "body": "Every DNS record has a **TTL** (Time to Live) in seconds. When it hits zero, the cached entry is discarded and the next request triggers a full re-resolution.\n\nChoosing TTL is a trade-off: **low TTL** = changes propagate fast but more DNS traffic; **high TTL** = fewer queries but slow propagation."
      },
      "activeText": "TTL expired (300s elapsed) — cache cleared",
      "hud": {
        "latency": 0
      },
      "canvas": {
        "dns-system": {
          "componentStates": {
            "browser": { "status": "normal" },
            "resolver": { "status": "normal" },
            "root-ns": { "status": "normal" },
            "tld-ns": { "status": "normal" },
            "auth-ns": { "status": "normal" }
          },
          "connectionStates": {
            "conn-browser-resolver": { "active": false },
            "conn-resolver-root-ns": { "active": false },
            "conn-resolver-tld-ns": { "active": false },
            "conn-resolver-auth-ns": { "active": false }
          }
        }
      }
    },
    {
      "index": 9,
      "explanation": {
        "heading": "Step 9",
        "body": "State updated."
      },
      "activeText": "Fresh lookup needed — full resolution chain repeats",
      "hud": {
        "latency": 150
      },
      "canvas": {
        "dns-system": {
          "componentStates": {
            "browser": { "status": "active" },
            "resolver": { "status": "active" },
            "root-ns": { "status": "active" },
            "tld-ns": { "status": "active" },
            "auth-ns": { "status": "active" }
          },
          "connectionStates": {
            "conn-browser-resolver": { "active": true },
            "conn-resolver-root-ns": { "active": true },
            "conn-resolver-tld-ns": { "active": true },
            "conn-resolver-auth-ns": { "active": true }
          }
        }
      }
    }
  ],
  "popups": [
    {
      "id": "pop-miss-browser",
      "attachTo": "dns-system",
      "text": "Cache MISS — no local record found",
      "showAtStep": 1,
      "hideAtStep": 1,
      "style": "warning"
    },
    {
      "id": "pop-root",
      "attachTo": "dns-system",
      "text": "Root NS: 13 clusters, anycast routed",
      "showAtStep": 2,
      "hideAtStep": 3,
      "style": "info"
    },
    {
      "id": "pop-hit",
      "attachTo": "dns-system",
      "text": "Cache HIT — full lookup skipped!",
      "showAtStep": 7,
      "hideAtStep": 8,
      "style": "success"
    },
    {
      "id": "pop-ttl",
      "attachTo": "dns-system",
      "text": "Low TTL = fast propagation, high TTL = fewer queries",
      "showAtStep": 8,
      "hideAtStep": 9,
      "style": "insight"
    }
  ],
  "challenges": [
    {
      "id": "ch-cache-off",
      "title": "Cache Off — Count the Hops",
      "description": "Disable the browser cache using the toggle above, then step through the simulation. Count exactly how many network round-trips happen for a cold lookup. Now re-enable cache and check the second request — what's the ratio?",
      "type": "predict"
    },
    {
      "id": "ch-ttl-tradeoff",
      "title": "TTL Trade-off Decision",
      "description": "You're deploying insyte.amanarya.com to a new IP address. Your current TTL is 3600s (1 hour). How long will it take for all users worldwide to see the new IP? What TTL would you set 24 hours before the migration? After?",
      "type": "scenario"
    },
    {
      "id": "ch-dns-poisoning",
      "title": "DNS Cache Poisoning",
      "description": "A malicious resolver returns a fake IP for insyte.amanarya.com, pointing to an attacker's server. The browser caches it. What prevents this attack in modern DNS? Look up DNSSEC.",
      "type": "break-it"
    }
  ]
}
