  "layout": "code-left-canvas-right",
  "description": "Visualize recursive split and merge in merge sort.",
  "category": "Data Structures & Algorithms",
  "code": {
    "language": "python",
    "source": "def merge_sort(arr):\n    if len(arr) <= 1:\n        return arr\n    mid = len(arr) // 2\n    left = merge_sort(arr[:mid])\n    right = merge_sort(arr[mid:])\n    i = j = 0\n    merged = []\n    while i < len(left) and j < len(right):\n        if left[i] <= right[j]:\n            merged.append(left[i])\n            i += 1\n        else:\n            merged.append(right[j])\n            j += 1\n    merged.extend(left[i:])\n    merged.extend(right[j:])\n    return merged\n\nfinalResult = merge_sort([8, 3, 5, 4, 7, 6, 1, 2])\n",
    "highlightByStep": [
      0,
      3,
      4,
      5,
      8,
      8,
      8,
      15,
      16,
      17
    ]
  },
