{
  "$schema": "/scene-schema.json",
  "id": "rate-limiter",
  "title": "Rate Limiter (Token Bucket)",
  "type": "lld",
  "layout": "text-left-canvas-right",
  "description": "Visualize how a Token Bucket rate limiter controls request throughput — the same algorithm used by Stripe, AWS API Gateway, and NGINX.",
  "category": "Low Level Design",
  "canvas": [
    {
      "id": "token-bucket",
      "type": "linear",
      "variant": "array",
      "layoutHint": "linear-H",
      "label": "Token Bucket  (T = available, · = consumed)",
      "initialState": {
        "items": [
          {
            "id": "slot-0",
            "value": "T",
            "highlight": "active"
          },
          {
            "id": "slot-1",
            "value": "T",
            "highlight": "active"
          },
          {
            "id": "slot-2",
            "value": "T",
            "highlight": "active"
          },
          {
            "id": "slot-3",
            "value": "T",
            "highlight": "active"
          },
          {
            "id": "slot-4",
            "value": "T",
            "highlight": "active"
          }
        ]
      }
    },
    {
      "id": "flow-diagram",
      "type": "system-diagram",
      "layoutHint": "dagre-LR",
      "label": "Request Flow",
      "initialState": {
        "components": [
          {
            "id": "client",
            "label": "Request",
            "icon": "web",
            "status": "normal"
          },
          {
            "id": "limiter",
            "label": "Rate Limiter",
            "icon": "shield",
            "status": "normal"
          },
          {
            "id": "api",
            "label": "API Server",
            "icon": "server",
            "status": "normal"
          }
        ],
        "connections": [
          {
            "id": "conn-client-limiter",
            "from": "client",
            "to": "limiter",
            "active": false
          },
          {
            "id": "conn-limiter-api",
            "from": "limiter",
            "to": "api",
            "active": false
          }
        ]
      }
    }
  ],
  "activeText": {
    "initialValue": "Token bucket: 5/5 tokens  (READY)"
  },
  "hud": [
    {
      "id": "allowed-counter",
      "label": "Allowed",
      "initialValue": 0
    },
    {
      "id": "rejected-counter",
      "label": "Rejected",
      "initialValue": 0
    }
  ],
  "controls": [
    {
      "id": "algo",
      "type": "toggle-group",
      "label": "Algorithm",
      "config": {
        "options": [
          "Token Bucket",
          "Fixed Window",
          "Sliding Window"
        ],
        "defaultValue": "Token Bucket"
      }
    },
    {
      "id": "btn-request",
      "type": "button",
      "label": "Send Request",
      "config": {
        "variant": "primary",
        "goToStep": 1
      }
    },
    {
      "id": "btn-burst",
      "type": "button",
      "label": "Burst 5 Requests",
      "config": {
        "variant": "destructive",
        "goToStep": 3
      }
    },
    {
      "id": "btn-refill",
      "type": "button",
      "label": "Token Refill",
      "config": {
        "variant": "secondary",
        "goToStep": 5
      }
    },
    {
      "id": "btn-overload",
      "type": "button",
      "label": "Overload System",
      "config": {
        "variant": "destructive",
        "goToStep": 9
      }
    }
  ],
  "steps": [
    {
      "index": 1,
      "explanation": {
        "heading": "Token Bucket Algorithm",
        "body": "Imagine a bucket that holds a fixed number of **tokens** (permits):\n- Each request consumes 1 token\n- Tokens **refill at a constant rate** (e.g., 3/second)\n- If bucket is empty → request rejected (HTTP 429)\n\nThe bucket size controls the **burst capacity**.",
        "callout": "Burst capacity = bucket size. Sustained rate = refill rate."
      },
      "activeText": "Request #1 arrives  →  token available  →  ALLOWED",
      "hud": {
        "allowed-counter": 1
      },
      "canvas": {
        "token-bucket": {
          "items": [
            {
              "id": "slot-0",
              "value": "·"
            },
            {
              "id": "slot-1",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-2",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-3",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-4",
              "value": "T",
              "highlight": "active"
            }
          ]
        },
        "flow-diagram": {
          "componentStates": {
            "client": { "status": "active" },
            "limiter": { "status": "active" },
            "api": { "status": "active" }
          },
          "connectionStates": {
            "conn-client-limiter": { "active": true },
            "conn-limiter-api": { "active": true }
          }
        }
      }
    },
    {
      "index": 2,
      "explanation": {
        "heading": "Step 2",
        "body": "State updated."
      },
      "activeText": "Requests #2 & #3  →  tokens consumed  →  ALLOWED",
      "hud": {
        "allowed-counter": 3
      },
      "canvas": {
        "token-bucket": {
          "items": [
            {
              "id": "slot-0",
              "value": "·"
            },
            {
              "id": "slot-1",
              "value": "·"
            },
            {
              "id": "slot-2",
              "value": "·"
            },
            {
              "id": "slot-3",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-4",
              "value": "T",
              "highlight": "active"
            }
          ]
        }
      }
    },
    {
      "index": 3,
      "explanation": {
        "heading": "Step 3",
        "body": "State updated."
      },
      "activeText": "Burst! 2 more requests  →  bucket exhausted",
      "hud": {
        "allowed-counter": 5
      },
      "canvas": {
        "token-bucket": {
          "items": [
            {
              "id": "slot-0",
              "value": "·"
            },
            {
              "id": "slot-1",
              "value": "·"
            },
            {
              "id": "slot-2",
              "value": "·"
            },
            {
              "id": "slot-3",
              "value": "·"
            },
            {
              "id": "slot-4",
              "value": "·"
            }
          ]
        },
        "flow-diagram": {
          "componentStates": {
            "client": { "status": "active" },
            "limiter": { "status": "overloaded" },
            "api": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-limiter": { "active": true },
            "conn-limiter-api": { "active": false }
          }
        }
      }
    },
    {
      "index": 4,
      "explanation": {
        "heading": "Bucket Exhausted → 429",
        "body": "When the bucket empties faster than it refills:\n- New requests arrive but no tokens available\n- Limiter returns **429 Too Many Requests**\n- Client should back off with exponential retry\n\nThe API server is **never overwhelmed** — the limiter absorbs the burst."
      },
      "activeText": "Request #6  →  NO tokens  →  REJECTED (429)",
      "hud": {
        "rejected-counter": 1
      },
      "canvas": {
        "flow-diagram": {
          "componentStates": {
            "client": { "status": "overloaded" },
            "limiter": { "status": "overloaded" },
            "api": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-limiter": { "active": true },
            "conn-limiter-api": { "active": false }
          }
        }
      }
    },
    {
      "index": 5,
      "explanation": {
        "heading": "Token Refill",
        "body": "Tokens refill at the **refill rate** (independent of requests).\n\nCommon strategies:\n- **Per-second**: add N tokens every second\n- **Smooth**: add 1 token every 1/N seconds (avoids micro-bursts)\n\nOnce full, extra tokens are discarded (bucket can't overflow)."
      },
      "activeText": "Refill interval!  →  2 tokens added  →  2/5",
      "canvas": {
        "token-bucket": {
          "items": [
            {
              "id": "slot-0",
              "value": "T",
              "highlight": "insert"
            },
            {
              "id": "slot-1",
              "value": "T",
              "highlight": "insert"
            },
            {
              "id": "slot-2",
              "value": "·"
            },
            {
              "id": "slot-3",
              "value": "·"
            },
            {
              "id": "slot-4",
              "value": "·"
            }
          ]
        },
        "flow-diagram": {
          "componentStates": {
            "client": { "status": "normal" },
            "limiter": { "status": "active" },
            "api": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-limiter": { "active": false },
            "conn-limiter-api": { "active": false }
          }
        }
      }
    },
    {
      "index": 6,
      "explanation": {
        "heading": "Step 6",
        "body": "State updated."
      },
      "activeText": "Request #7  →  token available  →  ALLOWED again",
      "hud": {
        "allowed-counter": 6
      },
      "canvas": {
        "token-bucket": {
          "items": [
            {
              "id": "slot-0",
              "value": "·"
            },
            {
              "id": "slot-1",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-2",
              "value": "·"
            },
            {
              "id": "slot-3",
              "value": "·"
            },
            {
              "id": "slot-4",
              "value": "·"
            }
          ]
        },
        "flow-diagram": {
          "componentStates": {
            "client": { "status": "active" },
            "limiter": { "status": "active" },
            "api": { "status": "active" }
          },
          "connectionStates": {
            "conn-client-limiter": { "active": true },
            "conn-limiter-api": { "active": true }
          }
        }
      }
    },
    {
      "index": 7,
      "explanation": {
        "heading": "Step 7",
        "body": "State updated."
      },
      "activeText": "Full refill  →  5/5 tokens  →  burst capacity restored",
      "canvas": {
        "token-bucket": {
          "items": [
            {
              "id": "slot-0",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-1",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-2",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-3",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-4",
              "value": "T",
              "highlight": "active"
            }
          ]
        }
      }
    },
    {
      "index": 8,
      "explanation": {
        "heading": "Steady State vs Overload",
        "body": "**Steady state**: request rate ≤ refill rate → bucket stays partially full, all requests pass.\n\n**Overload**: request rate > refill rate → bucket drains → rejections proportional to the excess.\n\nThe rejected fraction = `(arrival_rate - refill_rate) / arrival_rate`"
      },
      "activeText": "Steady state: 3 req/s arrive, 3 refill/s  →  no rejections",
      "canvas": {
        "token-bucket": {
          "items": [
            {
              "id": "slot-0",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-1",
              "value": "T",
              "highlight": "active"
            },
            {
              "id": "slot-2",
              "value": "·"
            },
            {
              "id": "slot-3",
              "value": "·"
            },
            {
              "id": "slot-4",
              "value": "·"
            }
          ]
        }
      }
    },
    {
      "index": 9,
      "explanation": {
        "heading": "Step 9",
        "body": "State updated."
      },
      "activeText": "Overload: 8 req/s arrive, 3 refill/s  →  queue builds, then drops",
      "hud": {
        "rejected-counter": 5,
        "allowed-counter": 9
      },
      "canvas": {
        "token-bucket": {
          "items": [
            {
              "id": "slot-0",
              "value": "·"
            },
            {
              "id": "slot-1",
              "value": "·"
            },
            {
              "id": "slot-2",
              "value": "·"
            },
            {
              "id": "slot-3",
              "value": "·"
            },
            {
              "id": "slot-4",
              "value": "·"
            }
          ]
        },
        "flow-diagram": {
          "componentStates": {
            "client": { "status": "overloaded" },
            "limiter": { "status": "overloaded" },
            "api": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-limiter": { "active": true },
            "conn-limiter-api": { "active": true }
          }
        }
      }
    }
  ],
  "popups": [
    {
      "id": "pop-token-consumed",
      "attachTo": "token-bucket",
      "text": "1 token consumed per request",
      "showAtStep": 1,
      "hideAtStep": 3,
      "style": "info"
    },
    {
      "id": "pop-empty-bucket",
      "attachTo": "token-bucket",
      "text": "Bucket empty! Reject incoming requests.",
      "showAtStep": 3,
      "hideAtStep": 5,
      "style": "warning"
    },
    {
      "id": "pop-refilling",
      "attachTo": "token-bucket",
      "text": "Refill rate: 2 tokens / interval",
      "showAtStep": 5,
      "hideAtStep": 7,
      "style": "success"
    }
  ],
  "challenges": [
    {
      "id": "ch-steady-50pct",
      "title": "50% Rejection Rate",
      "description": "Configure the token bucket so that exactly 50% of requests are rejected at steady state. If the refill rate is 4 tokens/second and bucket size is 4, what request rate would achieve exactly 50% rejection? Show your math.",
      "type": "optimize"
    },
    {
      "id": "ch-burst-allowed",
      "title": "Why Allow Bursts?",
      "description": "A customer complains: 'My app makes 100 API calls in 1 second every morning at 9am, then nothing for the rest of the hour.' Why is the Token Bucket better than a Fixed Window limiter for this use case? What bucket size should you configure?",
      "type": "scenario"
    },
    {
      "id": "ch-distributed",
      "title": "Distributed Rate Limiting",
      "description": "Your API runs on 10 servers. Each server runs its own token bucket limiter. A client sends 6 requests per second across all servers — each server allows 1 req/sec. What's the problem and how would you fix it?",
      "type": "break-it"
    }
  ]
}
