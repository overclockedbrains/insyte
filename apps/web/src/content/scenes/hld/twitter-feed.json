{
  "$schema": "/scene-schema.json",
  "id": "twitter-feed",
  "title": "Twitter Feed — Fanout Architecture",
  "type": "hld",
  "layout": "canvas-only",
  "description": "How Twitter delivers your feed in milliseconds — and why the celebrity problem breaks naive fanout. Visualize fanout-on-write vs fanout-on-read and the hybrid approach.",
  "category": "System Design",
  "canvas": [
    {
      "id": "twitter-system",
      "type": "system-diagram",
      "layoutHint": "dagre-LR",
      "label": "Twitter Feed Architecture",
      "initialState": {
        "components": [
          {
            "id": "writer",
            "label": "Writer",
            "icon": "mobile",
            "status": "normal"
          },
          {
            "id": "api-gw",
            "label": "API Gateway",
            "icon": "layers",
            "status": "normal"
          },
          {
            "id": "tweet-svc",
            "label": "Tweet Service",
            "icon": "server",
            "status": "normal"
          },
          {
            "id": "tweet-db",
            "label": "Tweet DB",
            "icon": "database",
            "status": "normal"
          },
          {
            "id": "fanout-svc",
            "label": "Fanout Service",
            "icon": "zap",
            "status": "normal"
          },
          {
            "id": "feed-cache-a",
            "label": "Feed Cache A",
            "icon": "zap",
            "status": "normal"
          },
          {
            "id": "feed-cache-b",
            "label": "Feed Cache B",
            "icon": "zap",
            "status": "normal"
          },
          {
            "id": "feed-cache-c",
            "label": "Feed Cache C",
            "icon": "zap",
            "status": "normal"
          },
          {
            "id": "reader",
            "label": "Reader",
            "icon": "mobile",
            "status": "normal"
          }
        ],
        "connections": [
          {
            "id": "conn-writer-api-gw",
            "from": "writer",
            "to": "api-gw",
            "active": false
          },
          {
            "id": "conn-api-gw-tweet-svc",
            "from": "api-gw",
            "to": "tweet-svc",
            "active": false
          },
          {
            "id": "conn-tweet-svc-tweet-db",
            "from": "tweet-svc",
            "to": "tweet-db",
            "active": false
          },
          {
            "id": "conn-api-gw-fanout-svc",
            "from": "api-gw",
            "to": "fanout-svc",
            "active": false,
            "style": "dashed"
          },
          {
            "id": "conn-fanout-svc-feed-cache-a",
            "from": "fanout-svc",
            "to": "feed-cache-a",
            "active": false
          },
          {
            "id": "conn-fanout-svc-feed-cache-b",
            "from": "fanout-svc",
            "to": "feed-cache-b",
            "active": false
          },
          {
            "id": "conn-fanout-svc-feed-cache-c",
            "from": "fanout-svc",
            "to": "feed-cache-c",
            "active": false
          },
          {
            "id": "conn-feed-cache-b-reader",
            "from": "feed-cache-b",
            "to": "reader",
            "active": false
          }
        ]
      }
    }
  ],
  "activeText": {
    "initialValue": "Fanout-on-Write  —  pre-compute feeds at write time"
  },
  "hud": [
    {
      "id": "stats-followers",
      "label": "Followers",
      "initialValue": 1000
    },
    {
      "id": "stats-writes",
      "label": "Cache Writes",
      "initialValue": 0
    }
  ],
  "controls": [
    {
      "id": "fanout-mode",
      "type": "toggle-group",
      "label": "Fanout Strategy",
      "config": {
        "options": [
          "Fanout-on-Write",
          "Fanout-on-Read",
          "Hybrid"
        ],
        "defaultValue": "Fanout-on-Write"
      }
    },
    {
      "id": "btn-post-tweet",
      "type": "button",
      "label": "Post Tweet",
      "config": {
        "variant": "primary",
        "goToStep": 1
      }
    },
    {
      "id": "btn-read-feed",
      "type": "button",
      "label": "Read Feed",
      "config": {
        "variant": "secondary",
        "goToStep": 3
      }
    },
    {
      "id": "btn-celebrity",
      "type": "button",
      "label": "Celebrity Tweets (50M followers)",
      "config": {
        "variant": "destructive",
        "goToStep": 4
      }
    },
    {
      "id": "btn-hybrid",
      "type": "button",
      "label": "Hybrid Fix",
      "config": {
        "variant": "secondary",
        "goToStep": 5
      }
    }
  ],
  "steps": [
    {
      "index": 1,
      "explanation": {
        "heading": "Step 1",
        "body": "State updated."
      },
      "activeText": "POST TWEET: Writer sends tweet to API Gateway",
      "canvas": {
        "twitter-system": {
          "componentStates": {
            "writer": { "status": "active" },
            "api-gw": { "status": "active" },
            "tweet-svc": { "status": "active" },
            "tweet-db": { "status": "active" },
            "fanout-svc": { "status": "normal" },
            "feed-cache-a": { "status": "normal" },
            "feed-cache-b": { "status": "normal" },
            "feed-cache-c": { "status": "normal" },
            "reader": { "status": "normal" }
          },
          "connectionStates": {
            "conn-writer-api-gw": { "active": true },
            "conn-api-gw-tweet-svc": { "active": true },
            "conn-tweet-svc-tweet-db": { "active": true },
            "conn-api-gw-fanout-svc": { "active": false },
            "conn-fanout-svc-feed-cache-a": { "active": false },
            "conn-fanout-svc-feed-cache-b": { "active": false },
            "conn-fanout-svc-feed-cache-c": { "active": false },
            "conn-feed-cache-b-reader": { "active": false }
          }
        }
      }
    },
    {
      "index": 2,
      "explanation": {
        "heading": "Fanout-on-Write",
        "body": "When a tweet is posted, immediately **push it into every follower's feed cache**.\n\n✓ Fast reads: feed is pre-computed, O(1) cache lookup\n✗ Slow writes: N cache updates per tweet (N = follower count)"
      },
      "activeText": "FANOUT-ON-WRITE: Fanout Service pushes tweet to ALL follower caches",
      "hud": {
        "stats-writes": 1000
      },
      "canvas": {
        "twitter-system": {
          "componentStates": {
            "writer": { "status": "normal" },
            "api-gw": { "status": "normal" },
            "tweet-svc": { "status": "normal" },
            "tweet-db": { "status": "normal" },
            "fanout-svc": { "status": "active" },
            "feed-cache-a": { "status": "active" },
            "feed-cache-b": { "status": "active" },
            "feed-cache-c": { "status": "active" },
            "reader": { "status": "normal" }
          },
          "connectionStates": {
            "conn-writer-api-gw": { "active": false },
            "conn-api-gw-tweet-svc": { "active": false },
            "conn-tweet-svc-tweet-db": { "active": false },
            "conn-api-gw-fanout-svc": { "active": true },
            "conn-fanout-svc-feed-cache-a": { "active": true },
            "conn-fanout-svc-feed-cache-b": { "active": true },
            "conn-fanout-svc-feed-cache-c": { "active": true },
            "conn-feed-cache-b-reader": { "active": false }
          }
        }
      }
    },
    {
      "index": 3,
      "explanation": {
        "heading": "Step 3",
        "body": "State updated."
      },
      "activeText": "READ FEED: Reader fetches pre-built feed from own cache  — O(1)!",
      "canvas": {
        "twitter-system": {
          "componentStates": {
            "writer": { "status": "normal" },
            "api-gw": { "status": "active" },
            "tweet-svc": { "status": "normal" },
            "tweet-db": { "status": "normal" },
            "fanout-svc": { "status": "normal" },
            "feed-cache-a": { "status": "normal" },
            "feed-cache-b": { "status": "active" },
            "feed-cache-c": { "status": "normal" },
            "reader": { "status": "active" }
          },
          "connectionStates": {
            "conn-writer-api-gw": { "active": false },
            "conn-api-gw-tweet-svc": { "active": false },
            "conn-tweet-svc-tweet-db": { "active": false },
            "conn-api-gw-fanout-svc": { "active": false },
            "conn-fanout-svc-feed-cache-a": { "active": false },
            "conn-fanout-svc-feed-cache-b": { "active": false },
            "conn-fanout-svc-feed-cache-c": { "active": false },
            "conn-feed-cache-b-reader": { "active": true }
          }
        }
      }
    },
    {
      "index": 4,
      "explanation": {
        "heading": "The Celebrity Problem",
        "body": "With Fanout-on-Write, a tweet from a 50M-follower account triggers **50 million cache writes** in seconds.\n\nThis is a write storm — the Fanout Service gets overwhelmed, latency spikes, users notice."
      },
      "activeText": "⚠️ CELEBRITY PROBLEM: User with 50M followers tweets — Fanout explodes!",
      "hud": {
        "stats-followers": 50000000,
        "stats-writes": 50000000
      },
      "canvas": {
        "twitter-system": {
          "componentStates": {
            "writer": { "status": "active" },
            "api-gw": { "status": "active" },
            "tweet-svc": { "status": "normal" },
            "tweet-db": { "status": "normal" },
            "fanout-svc": { "status": "overloaded" },
            "feed-cache-a": { "status": "overloaded" },
            "feed-cache-b": { "status": "overloaded" },
            "feed-cache-c": { "status": "overloaded" },
            "reader": { "status": "normal" }
          },
          "connectionStates": {
            "conn-writer-api-gw": { "active": true },
            "conn-api-gw-tweet-svc": { "active": true },
            "conn-tweet-svc-tweet-db": { "active": true },
            "conn-api-gw-fanout-svc": { "active": true },
            "conn-fanout-svc-feed-cache-a": { "active": true },
            "conn-fanout-svc-feed-cache-b": { "active": true },
            "conn-fanout-svc-feed-cache-c": { "active": true },
            "conn-feed-cache-b-reader": { "active": false }
          }
        }
      }
    },
    {
      "index": 5,
      "explanation": {
        "heading": "Hybrid Solution",
        "body": "Twitter's actual solution:\n- **Regular users** (< ~1M followers): fanout-on-write as normal\n- **Celebrities**: skip fanout — tweet lives only in Tweet DB\n\nOn read: merge the user's pre-built feed cache with the celebrity's tweet from DB.\n\nSmall overhead per read, but avoids the write storm."
      },
      "activeText": "HYBRID APPROACH: Celebrity tweets stored in Tweet DB — readers fetch on demand",
      "hud": {
        "stats-writes": 1
      },
      "canvas": {
        "twitter-system": {
          "componentStates": {
            "writer": { "status": "active" },
            "api-gw": { "status": "active" },
            "tweet-svc": { "status": "active" },
            "tweet-db": { "status": "active" },
            "fanout-svc": { "status": "normal" },
            "feed-cache-a": { "status": "normal" },
            "feed-cache-b": { "status": "normal" },
            "feed-cache-c": { "status": "normal" },
            "reader": { "status": "normal" }
          },
          "connectionStates": {
            "conn-writer-api-gw": { "active": true },
            "conn-api-gw-tweet-svc": { "active": true },
            "conn-tweet-svc-tweet-db": { "active": true },
            "conn-api-gw-fanout-svc": { "active": false },
            "conn-fanout-svc-feed-cache-a": { "active": false },
            "conn-fanout-svc-feed-cache-b": { "active": false },
            "conn-fanout-svc-feed-cache-c": { "active": false },
            "conn-feed-cache-b-reader": { "active": false }
          }
        }
      }
    }
  ],
  "popups": [
    {
      "id": "pop-fanout-cost",
      "attachTo": "twitter-system",
      "text": "1000 followers = 1000 cache writes per tweet",
      "showAtStep": 2,
      "hideAtStep": 4,
      "style": "info"
    },
    {
      "id": "pop-celebrity-storm",
      "attachTo": "twitter-system",
      "text": "50M writes in seconds — system collapses!",
      "showAtStep": 4,
      "hideAtStep": 5,
      "style": "warning"
    }
  ],
  "challenges": [
    {
      "id": "ch-fanout-read",
      "title": "Fanout-on-Read Trade-off",
      "description": "Design the Fanout-on-Read approach: when a user requests their feed, fetch tweets from all followed accounts' tweet DBs and merge them. What's the time complexity? Why does this approach fail at Twitter's scale?",
      "type": "scenario"
    },
    {
      "id": "ch-threshold",
      "title": "Celebrity Threshold",
      "description": "At what follower count should Twitter switch from fanout-on-write to the hybrid approach? Assume: 10ms per cache write, fanout must complete in <100ms total, writes are parallelized across 100 workers. Calculate the threshold.",
      "type": "optimize"
    },
    {
      "id": "ch-unfollow",
      "title": "Unfollow Problem",
      "description": "User unfollows someone mid-session. Their pre-built feed cache still contains tweets from the unfollowed account. How do you handle this? Should you invalidate the cache immediately? What consistency level is acceptable for a social feed?",
      "type": "break-it"
    }
  ]
}
