{
  "$schema": "/scene-schema.json",
  "id": "url-shortener",
  "title": "URL Shortener (bit.ly Architecture)",
  "type": "hld",
  "layout": "canvas-only",
  "description": "Design a URL shortener like bit.ly — the write path generates short IDs, the read path resolves them via Cache and Database with optional CDN.",
  "category": "System Design",
  "canvas": [
    {
      "id": "url-system",
      "type": "system-diagram",
      "layoutHint": "dagre-LR",
      "label": "URL Shortener Architecture",
      "initialState": {
        "components": [
          {
            "id": "client",
            "label": "Client",
            "icon": "web",
            "status": "normal"
          },
          {
            "id": "api",
            "label": "API Server",
            "icon": "server",
            "status": "normal"
          },
          {
            "id": "cache",
            "label": "Redis Cache",
            "icon": "zap",
            "status": "normal"
          },
          {
            "id": "db",
            "label": "Database",
            "icon": "database",
            "status": "normal"
          },
          {
            "id": "cdn",
            "label": "CDN Edge",
            "icon": "cloud",
            "status": "normal"
          }
        ],
        "connections": [
          {
            "id": "conn-client-api",
            "from": "client",
            "to": "api",
            "active": false
          },
          {
            "id": "conn-api-cache",
            "from": "api",
            "to": "cache",
            "active": false,
            "label": "read"
          },
          {
            "id": "conn-api-db",
            "from": "api",
            "to": "db",
            "active": false,
            "label": "write"
          },
          {
            "id": "conn-cdn-client",
            "from": "cdn",
            "to": "client",
            "active": false,
            "style": "dashed"
          }
        ]
      }
    },
    {
      "id": "url-system-no-cache",
      "type": "system-diagram",
      "layoutHint": "dagre-LR",
      "label": "URL Shortener (Cache Off)",
      "initialState": {
        "components": [
          {
            "id": "client2",
            "label": "Client",
            "icon": "web",
            "status": "normal"
          },
          {
            "id": "api2",
            "label": "API Server",
            "icon": "server",
            "status": "normal"
          },
          {
            "id": "db2",
            "label": "Database",
            "icon": "database",
            "status": "normal"
          }
        ],
        "connections": [
          {
            "id": "conn-client2-api2",
            "from": "client2",
            "to": "api2",
            "active": false
          },
          {
            "id": "conn-api2-db2",
            "from": "api2",
            "to": "db2",
            "active": false
          }
        ]
      }
    }
  ],
  "activeText": {
    "initialValue": "Ready  —  Click 'Shorten URL' or 'Resolve URL' to start"
  },
  "hud": [
    {
      "id": "stats-total",
      "label": "Requests",
      "initialValue": 0
    },
    {
      "id": "stats-cache-hit",
      "label": "Cache Hits",
      "initialValue": 0
    },
    {
      "id": "stats-db",
      "label": "DB Reads",
      "initialValue": 0
    }
  ],
  "controls": [
    {
      "id": "cache-toggle",
      "type": "toggle",
      "label": "Cache (Redis)",
      "config": {
        "defaultValue": true
      }
    },
    {
      "id": "cdn-toggle",
      "type": "toggle",
      "label": "CDN Edge",
      "config": {
        "defaultValue": false
      }
    },
    {
      "id": "btn-shorten",
      "type": "button",
      "label": "Shorten URL",
      "config": {
        "variant": "primary",
        "goToStep": 1
      }
    },
    {
      "id": "btn-resolve",
      "type": "button",
      "label": "Resolve URL (cache hit)",
      "config": {
        "variant": "secondary",
        "goToStep": 3
      }
    },
    {
      "id": "btn-cache-miss",
      "type": "button",
      "label": "Resolve (cache miss)",
      "config": {
        "variant": "destructive",
        "goToStep": 5
      }
    },
    {
      "id": "btn-cdn",
      "type": "button",
      "label": "CDN Edge Resolution",
      "config": {
        "variant": "secondary",
        "goToStep": 7
      }
    }
  ],
  "steps": [
    {
      "index": 1,
      "explanation": {
        "heading": "Write Path: Generate Short ID",
        "body": "**PUT /shorten**: API generates a 6-character Base62 ID (62^6 = 56 billion possible IDs) and stores the mapping in the database.\n\nBase62 uses [a-z A-Z 0-9] for URL-safe IDs."
      },
      "activeText": "WRITE PATH: Client sends long URL to API Server",
      "hud": {
        "stats-total": 1
      },
      "canvas": {
        "url-system": {
          "componentStates": {
            "client": { "status": "active" },
            "api": { "status": "active" },
            "cache": { "status": "normal" },
            "db": { "status": "normal" },
            "cdn": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-api": { "active": true },
            "conn-api-cache": { "active": false },
            "conn-api-db": { "active": false },
            "conn-cdn-client": { "active": false }
          }
        }
      }
    },
    {
      "index": 2,
      "explanation": {
        "heading": "Step 2",
        "body": "State updated."
      },
      "activeText": "WRITE PATH: API generates Base62 short ID → stores in DB",
      "canvas": {
        "url-system": {
          "componentStates": {
            "client": { "status": "normal" },
            "api": { "status": "active" },
            "cache": { "status": "normal" },
            "db": { "status": "active" },
            "cdn": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-api": { "active": false },
            "conn-api-cache": { "active": false },
            "conn-api-db": { "active": true },
            "conn-cdn-client": { "active": false }
          }
        }
      }
    },
    {
      "index": 3,
      "explanation": {
        "heading": "Read Path: Cache-First",
        "body": "**GET /abc123**: Check Redis first (sub-ms latency). Cache hit rate > 80% for popular URLs.\n\nOnly fall through to DB on a miss. Write result back to cache for next time."
      },
      "activeText": "READ PATH: Client resolves short URL → API checks Cache first",
      "hud": {
        "stats-total": 2
      },
      "canvas": {
        "url-system": {
          "componentStates": {
            "client": { "status": "active" },
            "api": { "status": "active" },
            "cache": { "status": "active" },
            "db": { "status": "normal" },
            "cdn": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-api": { "active": true },
            "conn-api-cache": { "active": true },
            "conn-api-db": { "active": false },
            "conn-cdn-client": { "active": false }
          }
        }
      }
    },
    {
      "index": 4,
      "explanation": {
        "heading": "Step 4",
        "body": "State updated."
      },
      "activeText": "CACHE HIT! Redis returns long URL → API redirects client (301/302)",
      "hud": {
        "stats-cache-hit": 1
      },
      "canvas": {
        "url-system": {
          "componentStates": {
            "client": { "status": "active" },
            "api": { "status": "active" },
            "cache": { "status": "active" },
            "db": { "status": "normal" },
            "cdn": { "status": "normal" }
          },
          "connectionStates": {
            "conn-api-cache": { "active": true },
            "conn-api-db": { "active": false },
            "conn-cdn-client": { "active": false }
          },
          "newConnections": [
            {
              "id": "conn-api-client",
              "from": "api",
              "to": "client",
              "active": true,
              "label": "302 redirect"
            }
          ]
        }
      }
    },
    {
      "index": 5,
      "explanation": {
        "heading": "Step 5",
        "body": "State updated."
      },
      "activeText": "CACHE MISS: shortID not in cache → fall through to Database",
      "hud": {
        "stats-total": 3,
        "stats-db": 1
      },
      "canvas": {
        "url-system": {
          "componentStates": {
            "client": { "status": "active" },
            "api": { "status": "active" },
            "cache": { "status": "overloaded" },
            "db": { "status": "active" },
            "cdn": { "status": "normal" }
          },
          "connectionStates": {
            "conn-client-api": { "active": true },
            "conn-api-cache": { "active": true },
            "conn-api-db": { "active": true },
            "conn-cdn-client": { "active": false }
          }
        }
      }
    },
    {
      "index": 6,
      "explanation": {
        "heading": "Step 6",
        "body": "State updated."
      },
      "activeText": "DB hit → populate cache (write-through) → redirect client",
      "canvas": {
        "url-system": {
          "componentStates": {
            "client": { "status": "active" },
            "api": { "status": "active" },
            "cache": { "status": "active" },
            "db": { "status": "normal" },
            "cdn": { "status": "normal" }
          },
          "connectionStates": {
            "conn-api-cache": { "active": true },
            "conn-api-db": { "active": false },
            "conn-cdn-client": { "active": false }
          },
          "newConnections": [
            {
              "id": "conn-api-client-redirect",
              "from": "api",
              "to": "client",
              "active": true,
              "label": "302 redirect"
            }
          ]
        }
      }
    },
    {
      "index": 7,
      "explanation": {
        "heading": "CDN for Maximum Speed",
        "body": "For highly popular URLs, cache the redirect at CDN edge nodes globally.\n\nThe redirect never reaches your origin servers — pure edge resolution at <10ms from anywhere."
      },
      "activeText": "CDN ENABLED: static redirects cached at edge — 0 DB calls",
      "hud": {
        "stats-total": 10,
        "stats-cache-hit": 10,
        "stats-db": 1
      },
      "canvas": {
        "url-system": {
          "componentStates": {
            "client": { "status": "active" },
            "api": { "status": "normal" },
            "cache": { "status": "normal" },
            "db": { "status": "normal" },
            "cdn": { "status": "active" }
          },
          "connectionStates": {
            "conn-cdn-client": { "active": true },
            "conn-client-api": { "active": false },
            "conn-api-cache": { "active": false },
            "conn-api-db": { "active": false }
          }
        }
      }
    }
  ],
  "popups": [
    {
      "id": "pop-base62",
      "attachTo": "url-system",
      "text": "Base62: [a-z A-Z 0-9] = URL-safe IDs",
      "showAtStep": 2,
      "hideAtStep": 3,
      "style": "info"
    },
    {
      "id": "pop-301-vs-302",
      "attachTo": "url-system",
      "text": "301 = permanent (browser caches). 302 = temporary (always hits your server).",
      "showAtStep": 4,
      "hideAtStep": 6,
      "style": "insight"
    }
  ],
  "challenges": [
    {
      "id": "ch-301-vs-302",
      "title": "301 vs 302 Redirect",
      "description": "Should the short URL redirect use HTTP 301 (Permanent) or 302 (Temporary)? 301 means browsers cache the redirect and never call your server again — great for performance but you lose click analytics. 302 hits your server every time. Which would you choose for a business? Why?",
      "type": "scenario"
    },
    {
      "id": "ch-collision",
      "title": "ID Collision",
      "description": "Two users submit different long URLs that hash to the same short ID. How do you handle this? Design the put() algorithm to guarantee uniqueness. What happens when the ID space (62^6 = 56B) fills up?",
      "type": "break-it"
    },
    {
      "id": "ch-scale",
      "title": "10B URLs, 100M resolutions/day",
      "description": "The system needs to handle 10 billion stored URLs and 100 million resolutions per day. Walk through the capacity estimates: storage size, cache memory needed, DB read QPS, required DB sharding strategy.",
      "type": "optimize"
    }
  ]
}
