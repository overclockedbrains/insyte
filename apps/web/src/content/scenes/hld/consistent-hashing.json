{
  "$schema": "/scene-schema.json",
  "id": "consistent-hashing",
  "title": "Consistent Hashing",
  "type": "hld",
  "layout": "canvas-only",
  "description": "Why consistent hashing is critical for distributed systems — add or remove servers with minimal key redistribution. The algorithm behind DynamoDB, Cassandra, and Memcached.",
  "category": "System Design",
  "canvas": [
    {
      "id": "hash-ring",
      "type": "graph",
      "layoutHint": "dagre-TB",
      "label": "Hash Ring  (servers = large nodes, keys = small cyan nodes)",
      "initialState": {
        "nodes": [
          {
            "id": "sA",
            "label": "Server A"
          },
          {
            "id": "sB",
            "label": "Server B"
          },
          {
            "id": "sC",
            "label": "Server C"
          },
          {
            "id": "k1",
            "label": "k1"
          },
          {
            "id": "k2",
            "label": "k2"
          },
          {
            "id": "k3",
            "label": "k3"
          },
          {
            "id": "k4",
            "label": "k4"
          },
          {
            "id": "k5",
            "label": "k5"
          }
        ],
        "edges": [
          {
            "id": "e-sA-sB",
            "from": "sA",
            "to": "sB"
          },
          {
            "id": "e-sB-sC",
            "from": "sB",
            "to": "sC"
          },
          {
            "id": "e-sC-sA",
            "from": "sC",
            "to": "sA"
          }
        ]
      }
    }
  ],
  "activeText": {
    "initialValue": "Ring: 3 servers (A, B, C)  —  keys routed clockwise to next server"
  },
  "hud": [
    {
      "id": "keys-moved-counter",
      "label": "Keys Moved",
      "initialValue": 0
    }
  ],
  "controls": [
    {
      "id": "virtual-nodes",
      "type": "toggle",
      "label": "Virtual Nodes",
      "config": {
        "defaultValue": false
      }
    },
    {
      "id": "btn-add-server",
      "type": "button",
      "label": "Add Server D",
      "config": {
        "variant": "primary",
        "goToStep": 2
      }
    },
    {
      "id": "btn-remove-server",
      "type": "button",
      "label": "Remove Server B",
      "config": {
        "variant": "destructive",
        "goToStep": 3
      }
    },
    {
      "id": "btn-virtual",
      "type": "button",
      "label": "Show Virtual Nodes",
      "config": {
        "variant": "secondary",
        "goToStep": 4
      }
    }
  ],
  "steps": [
    {
      "index": 1,
      "explanation": {
        "heading": "Step 1",
        "body": "State updated."
      },
      "activeText": "Keys distributed: k1,k2 → Server B  |  k3 → Server C  |  k4,k5 → Server A",
      "canvas": {
        "hash-ring": {
          "updateNodes": [
            { "id": "sA", "label": "A (k4,k5)" },
            { "id": "sB", "label": "B (k1,k2)" },
            { "id": "sC", "label": "C (k3)" }
          ],
          "nodeStates": {
            "sA": { "highlight": "active" },
            "sB": { "highlight": "active" },
            "sC": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 2,
      "explanation": {
        "heading": "Adding a Server",
        "body": "Adding Server D between A and B on the ring only moves **keys that were between A and D**.\n\nOnly those keys now belong to D. All other keys remain with their current servers.\n\nRatio of keys moved: `1/N` on average (where N = new total servers)."
      },
      "activeText": "ADD Server D between A and B  →  only k1 moves from B to D  (minimal redistribution!)",
      "hud": {
        "keys-moved-counter": 1
      },
      "canvas": {
        "hash-ring": {
          "newNodes": [
            { "id": "sD", "label": "Server D" }
          ],
          "newEdges": [
            { "id": "e-sA-sD", "from": "sA", "to": "sD" },
            { "id": "e-sD-sB", "from": "sD", "to": "sB" }
          ],
          "updateNodes": [
            { "id": "sB", "label": "B (k2)" },
            { "id": "k1", "label": "k1→D" }
          ],
          "edgeStates": {
            "e-sA-sB": { "highlight": "default" }
          },
          "nodeStates": {
            "sD": { "highlight": "active" },
            "k1": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 3,
      "explanation": {
        "heading": "Removing a Server",
        "body": "Removing Server B: only B's keys need to move — they shift to the **next server clockwise** (C).\n\nAgain, only ~1/N of all keys are affected.\n\nThis is the key property: **minimal disruption** during topology changes."
      },
      "activeText": "REMOVE Server B  →  only B's keys (k2) shift to next server C  (1 key moved)",
      "hud": {
        "keys-moved-counter": 1
      },
      "canvas": {
        "hash-ring": {
          "newEdges": [
            { "id": "e-sD-sC", "from": "sD", "to": "sC" }
          ],
          "updateNodes": [
            { "id": "sD", "label": "D (k1)" },
            { "id": "sC", "label": "C (k2,k3)" },
            { "id": "k2", "label": "k2→C" }
          ],
          "edgeStates": {
            "e-sD-sB": { "highlight": "default" },
            "e-sB-sC": { "highlight": "default" }
          },
          "nodeStates": {
            "sB": { "highlight": "default" },
            "k2": { "highlight": "active" }
          }
        }
      }
    },
    {
      "index": 4,
      "explanation": {
        "heading": "Virtual Nodes",
        "body": "Problem: with few servers, key distribution can be uneven (hot spots).\n\nSolution: each physical server gets **V virtual nodes** on the ring, with different hash positions.\n\nMore virtual nodes = smoother distribution. Cassandra defaults to 256 virtual nodes per server."
      },
      "activeText": "VIRTUAL NODES: Each server gets 3 ring positions — more uniform key distribution",
      "hud": {
        "keys-moved-counter": 0
      },
      "canvas": {
        "hash-ring": {
          "newNodes": [
            { "id": "sA1", "label": "A-1" },
            { "id": "sA2", "label": "A-2" },
            { "id": "sA3", "label": "A-3" },
            { "id": "sB1", "label": "B-1" },
            { "id": "sB2", "label": "B-2" },
            { "id": "sB3", "label": "B-3" },
            { "id": "sC1", "label": "C-1" },
            { "id": "sC2", "label": "C-2" },
            { "id": "sC3", "label": "C-3" }
          ],
          "newEdges": [
            { "id": "e-sA1-sB1", "from": "sA1", "to": "sB1" },
            { "id": "e-sB1-sA3", "from": "sB1", "to": "sA3" },
            { "id": "e-sA3-sC2", "from": "sA3", "to": "sC2" },
            { "id": "e-sC2-sB2", "from": "sC2", "to": "sB2" },
            { "id": "e-sB2-sB3", "from": "sB2", "to": "sB3" },
            { "id": "e-sB3-sC1", "from": "sB3", "to": "sC1" },
            { "id": "e-sC1-sA2", "from": "sC1", "to": "sA2" },
            { "id": "e-sA2-sC3", "from": "sA2", "to": "sC3" },
            { "id": "e-sC3-sA1", "from": "sC3", "to": "sA1" }
          ],
          "nodeStates": {
            "sA1": { "highlight": "active" },
            "sA2": { "highlight": "active" },
            "sA3": { "highlight": "active" },
            "sB1": { "highlight": "active" },
            "sB2": { "highlight": "active" },
            "sB3": { "highlight": "active" },
            "sC1": { "highlight": "active" },
            "sC2": { "highlight": "active" },
            "sC3": { "highlight": "active" }
          }
        }
      }
    }
  ],
  "popups": [
    {
      "id": "pop-clockwise",
      "attachTo": "hash-ring",
      "text": "Each key routes to first server clockwise",
      "showAtStep": 1,
      "hideAtStep": 2,
      "style": "info"
    },
    {
      "id": "pop-minimal",
      "attachTo": "hash-ring",
      "text": "Only 1 of 5 keys moved — that's optimal!",
      "showAtStep": 2,
      "hideAtStep": 3,
      "style": "success"
    }
  ],
  "challenges": [
    {
      "id": "ch-naive-vs-consistent",
      "title": "Naive vs Consistent — The Math",
      "description": "You have a cache cluster with 4 servers storing 1 million keys. You add a 5th server. With naive modulo hashing (hash % N), how many keys need to remigrate? With consistent hashing, how many? Show the calculation for both.",
      "type": "predict"
    },
    {
      "id": "ch-hotspot",
      "title": "Hot Spot Without Virtual Nodes",
      "description": "With only 3 servers on a ring and uniformly distributed key hashes, Server A covers 60% of the ring arc, B covers 25%, C covers 15%. What's the load imbalance? How many virtual nodes per server would reduce the standard deviation of loads to under 5%?",
      "type": "optimize"
    },
    {
      "id": "ch-replication",
      "title": "Replication with Consistent Hashing",
      "description": "DynamoDB replicates each key on the next N servers clockwise (N=3 by default). When Server B goes down, which servers now serve its keys? Draw the replica assignment for 4 servers and 5 keys from the simulation.",
      "type": "scenario"
    }
  ]
}
