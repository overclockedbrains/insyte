{
  "$schema": "/scene-schema.json",
  "id": "chat-system",
  "title": "Chat System (WhatsApp Architecture)",
  "type": "hld",
  "layout": "canvas-only",
  "description": "How real-time messaging works under the hood — WebSocket connections, message queues for offline users, and delivery guarantees. The architecture behind WhatsApp and Slack.",
  "category": "System Design",
  "canvas": [
    {
      "id": "chat-system",
      "type": "system-diagram",
      "layoutHint": "dagre-LR",
      "label": "Chat System Architecture",
      "initialState": {
        "components": [
          {
            "id": "clientA",
            "label": "Client A",
            "icon": "mobile",
            "status": "active"
          },
          {
            "id": "ws1",
            "label": "WS Server 1",
            "icon": "server",
            "status": "active"
          },
          {
            "id": "ws2",
            "label": "WS Server 2",
            "icon": "server",
            "status": "normal"
          },
          {
            "id": "msg-queue",
            "label": "Message Queue",
            "icon": "layers",
            "status": "normal"
          },
          {
            "id": "msg-db",
            "label": "Message DB",
            "icon": "database",
            "status": "normal"
          },
          {
            "id": "notif-svc",
            "label": "Push Notify",
            "icon": "zap",
            "status": "normal"
          },
          {
            "id": "clientB",
            "label": "Client B",
            "icon": "mobile",
            "status": "active"
          }
        ],
        "connections": [
          {
            "id": "conn-clientA-ws1",
            "from": "clientA",
            "to": "ws1",
            "active": true,
            "label": "WS open"
          },
          {
            "id": "conn-ws1-msg-queue",
            "from": "ws1",
            "to": "msg-queue",
            "active": false
          },
          {
            "id": "conn-msg-queue-msg-db",
            "from": "msg-queue",
            "to": "msg-db",
            "active": false
          },
          {
            "id": "conn-msg-queue-ws2",
            "from": "msg-queue",
            "to": "ws2",
            "active": false,
            "style": "dashed"
          },
          {
            "id": "conn-ws2-clientB",
            "from": "ws2",
            "to": "clientB",
            "active": true,
            "label": "WS open"
          },
          {
            "id": "conn-msg-queue-notif-svc",
            "from": "msg-queue",
            "to": "notif-svc",
            "active": false,
            "style": "dashed"
          }
        ]
      }
    }
  ],
  "activeText": {
    "initialValue": "Both clients ONLINE  —  WebSocket connections established"
  },
  "hud": [
    {
      "id": "msg-counter",
      "label": "Messages",
      "initialValue": 0
    }
  ],
  "controls": [
    {
      "id": "transport",
      "type": "toggle-group",
      "label": "Transport Protocol",
      "config": {
        "options": [
          "WebSocket",
          "Long Polling",
          "SSE"
        ],
        "defaultValue": "WebSocket"
      }
    },
    {
      "id": "user-b-online",
      "type": "toggle",
      "label": "User B Online",
      "config": {
        "defaultValue": true
      }
    },
    {
      "id": "btn-send",
      "type": "button",
      "label": "Send Message",
      "config": {
        "variant": "primary",
        "goToStep": 1
      }
    },
    {
      "id": "btn-offline",
      "type": "button",
      "label": "User B Goes Offline",
      "config": {
        "variant": "destructive",
        "goToStep": 3
      }
    },
    {
      "id": "btn-offline-msg",
      "type": "button",
      "label": "Send While Offline",
      "config": {
        "variant": "primary",
        "goToStep": 4
      }
    },
    {
      "id": "btn-reconnect",
      "type": "button",
      "label": "User B Reconnects",
      "config": {
        "variant": "secondary",
        "goToStep": 5
      }
    }
  ],
  "steps": [
    {
      "index": 1,
      "explanation": {
        "heading": "Message Queue: The Reliability Layer",
        "body": "Messages go through a Message Queue (Kafka, RabbitMQ) before delivery.\n\nThis decouples senders from receivers and guarantees **at-least-once delivery**.\n\nIf the destination WebSocket server is down, the queue retains the message."
      },
      "activeText": "Client A sends message  →  travels through WS Server 1 → Message Queue",
      "canvas": {
        "chat-system": {
          "componentStates": {
            "clientA": { "status": "active" },
            "ws1": { "status": "active" },
            "ws2": { "status": "normal" },
            "msg-queue": { "status": "active" },
            "msg-db": { "status": "active" },
            "notif-svc": { "status": "normal" },
            "clientB": { "status": "active" }
          },
          "connectionStates": {
            "conn-clientA-ws1": { "active": true },
            "conn-ws1-msg-queue": { "active": true },
            "conn-msg-queue-msg-db": { "active": true },
            "conn-msg-queue-ws2": { "active": false },
            "conn-ws2-clientB": { "active": true },
            "conn-msg-queue-notif-svc": { "active": false }
          }
        }
      }
    },
    {
      "index": 2,
      "explanation": {
        "heading": "Step 2",
        "body": "State updated."
      },
      "activeText": "Queue routes to WS Server 2 → delivers to Client B via open WebSocket",
      "hud": {
        "msg-counter": 1
      },
      "canvas": {
        "chat-system": {
          "componentStates": {
            "clientA": { "status": "normal" },
            "ws1": { "status": "normal" },
            "ws2": { "status": "active" },
            "msg-queue": { "status": "active" },
            "msg-db": { "status": "normal" },
            "notif-svc": { "status": "normal" },
            "clientB": { "status": "active" }
          },
          "connectionStates": {
            "conn-clientA-ws1": { "active": false },
            "conn-ws1-msg-queue": { "active": false },
            "conn-msg-queue-msg-db": { "active": false },
            "conn-msg-queue-ws2": { "active": true },
            "conn-ws2-clientB": { "active": true },
            "conn-msg-queue-notif-svc": { "active": false }
          }
        }
      }
    },
    {
      "index": 3,
      "explanation": {
        "heading": "Step 3",
        "body": "State updated."
      },
      "activeText": "Client B goes OFFLINE  →  WebSocket connection drops",
      "canvas": {
        "chat-system": {
          "componentStates": {
            "clientA": { "status": "active" },
            "ws1": { "status": "active" },
            "ws2": { "status": "normal" },
            "msg-queue": { "status": "normal" },
            "msg-db": { "status": "normal" },
            "notif-svc": { "status": "normal" },
            "clientB": { "status": "dead" }
          },
          "connectionStates": {
            "conn-clientA-ws1": { "active": true },
            "conn-ws1-msg-queue": { "active": false },
            "conn-msg-queue-msg-db": { "active": false },
            "conn-msg-queue-ws2": { "active": false },
            "conn-ws2-clientB": { "active": false },
            "conn-msg-queue-notif-svc": { "active": false }
          }
        }
      }
    },
    {
      "index": 4,
      "explanation": {
        "heading": "Offline Delivery: Queue + Push",
        "body": "When recipient is offline:\n1. Message stored in DB\n2. Push notification sent via APNS/FCM\n3. On reconnect, client fetches missed messages from DB (via cursor-based pagination)\n\nThis is **store-and-forward** — the same model used by email."
      },
      "activeText": "Client A sends message while B is offline  →  queued in Message DB",
      "canvas": {
        "chat-system": {
          "componentStates": {
            "clientA": { "status": "active" },
            "ws1": { "status": "active" },
            "ws2": { "status": "normal" },
            "msg-queue": { "status": "active" },
            "msg-db": { "status": "active" },
            "notif-svc": { "status": "active" },
            "clientB": { "status": "dead" }
          },
          "connectionStates": {
            "conn-clientA-ws1": { "active": true },
            "conn-ws1-msg-queue": { "active": true },
            "conn-msg-queue-msg-db": { "active": true },
            "conn-msg-queue-ws2": { "active": false },
            "conn-ws2-clientB": { "active": false },
            "conn-msg-queue-notif-svc": { "active": true }
          }
        }
      }
    },
    {
      "index": 5,
      "explanation": {
        "heading": "Reconnect: Drain the Queue",
        "body": "On reconnect, the client sends its **last seen message ID**.\n\nThe server fetches all messages after that ID from the DB and pushes them in order.\n\nThis ensures no message is skipped even if the client was offline for days."
      },
      "activeText": "Client B comes back ONLINE  →  reconnects WebSocket → drains message queue",
      "hud": {
        "msg-counter": 3
      },
      "canvas": {
        "chat-system": {
          "componentStates": {
            "clientA": { "status": "normal" },
            "ws1": { "status": "normal" },
            "ws2": { "status": "active" },
            "msg-queue": { "status": "active" },
            "msg-db": { "status": "active" },
            "notif-svc": { "status": "normal" },
            "clientB": { "status": "active" }
          },
          "connectionStates": {
            "conn-clientA-ws1": { "active": false },
            "conn-ws1-msg-queue": { "active": false },
            "conn-msg-queue-msg-db": { "active": false },
            "conn-msg-queue-ws2": { "active": true },
            "conn-ws2-clientB": { "active": true },
            "conn-msg-queue-notif-svc": { "active": false }
          },
          "newConnections": [
            {
              "id": "conn-msg-db-msg-queue",
              "from": "msg-db",
              "to": "msg-queue",
              "active": true,
              "label": "drain queue"
            }
          ]
        }
      }
    }
  ],
  "popups": [
    {
      "id": "pop-ws-vs-polling",
      "attachTo": "chat-system",
      "text": "Long Polling: client re-requests every N seconds — 100× more overhead",
      "showAtStep": 1,
      "hideAtStep": 1,
      "style": "info"
    },
    {
      "id": "pop-offline-queue",
      "attachTo": "chat-system",
      "text": "Message queued — won't be lost even if server restarts",
      "showAtStep": 4,
      "hideAtStep": 5,
      "style": "warning"
    }
  ],
  "challenges": [
    {
      "id": "ch-server-selection",
      "title": "WebSocket Server Selection",
      "description": "Client A is connected to WS Server 1, Client B to WS Server 2. How does Server 1 know which server to forward the message to? Design the routing mechanism using a service discovery layer (e.g., Redis with userId → serverId mapping).",
      "type": "scenario"
    },
    {
      "id": "ch-delivery-guarantees",
      "title": "Exactly-Once Delivery",
      "description": "The Message Queue guarantees at-least-once delivery. But if Server 2 crashes after receiving but before acknowledging, the message gets re-delivered and Client B sees it twice. How would you implement exactly-once delivery? What's the cost?",
      "type": "break-it"
    },
    {
      "id": "ch-group-chat",
      "title": "Extend to Group Chat",
      "description": "Design group chat with 1000 members. When a message is sent, it needs to reach all 1000 members. Should you use fanout-on-write (pre-push to all) or fanout-on-read (store once, fetch on demand)? What's the crossover point?",
      "type": "optimize"
    }
  ]
}
