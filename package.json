{
  "name": "insyte",
  "version": "2.4.0",
  "description": "An AI-powered interactive learning platform for live algorithmic traces and system design simulations.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "validate-scenes": "pnpm --filter web validate-scenes",
    "img:webp": "node scripts/image-to-webp.mjs",
    "clean": "turbo clean && pnpm -r exec rimraf .next dist .turbo tsconfig.tsbuildinfo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "setup-symlinks": "node scripts/setup-symlinks.mjs",
    "qa": "node scripts/qa.mjs",
    "browser-skill": "pnpm --dir .github/skills/browser exec browser-skill",
    "browser-skill:open": "pnpm --dir .github/skills/browser exec browser-skill open",
    "browser-skill:screenshot": "pnpm --dir .github/skills/browser exec browser-skill screenshot",
    "browser-skill:extract": "pnpm --dir .github/skills/browser exec browser-skill extract",
    "browser-skill:fill": "pnpm --dir .github/skills/browser exec browser-skill fill",
    "browser-skill:metadata": "pnpm --dir .github/skills/browser exec browser-skill metadata"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overclockedbrains/insyte.git"
  },
  "author": "Aman Arya (Am4nn)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/overclockedbrains/insyte/issues"
  },
  "homepage": "https://github.com/overclockedbrains/insyte#readme",
  "devDependencies": {
    "@types/node": "^20.19.39",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}